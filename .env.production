# .env.production — loaded by Astro/Vite during `astro build`.
#
# Why committed (not gitignored): the variables here are PUBLIC_* prefixed,
# which means Astro inlines their values into the generated static HTML at
# build time. They're VISIBLE in every deployed page's source — there's no
# secret to protect. Committing them avoids the build dependency on
# Cloudflare Pages dashboard env vars (which apply at the Worker runtime
# layer, not the static build layer for projects with no Functions).
#
# If you ever rotate a public ID below: edit, commit, push, and Cloudflare
# Pages auto-rebuilds.

# Google Analytics 4 — Measurement ID for the forgerpa.com web data stream.
# Created via https://analytics.google.com Admin → Data Streams.
PUBLIC_GA4_MEASUREMENT_ID=G-T2NC3F68M5
