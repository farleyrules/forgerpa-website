---
/**
 * Mobile-only sticky booking CTA: a fixed full-width bottom bar that keeps a
 * one-tap path to /book in view no matter how far the visitor has scrolled.
 *
 * Why mobile-only: GA4 showed paid mobile visitors reach /book at ~6% of their
 * sessions vs ~17% on desktop, so the booking CTA is the weak link specifically
 * on mobile (desktop already has the hero + mid + bottom CTAs in easy reach).
 * Hidden at >=sm so it never disturbs the working desktop experience.
 *
 * The link carries the page's attribution (?from=...) by accepting the page's
 * heroCtaLink, so the new landing-page -> /book reporting stays intact.
 */
interface Props {
  /** Where the CTA points; pass the page's heroCtaLink to keep ?from= attribution. */
  link?: string;
  /** Button label. Kept benefit-first + low-friction (free, 30 min). */
  text?: string;
}

const { link = "/contact", text = "Contact Us" } = Astro.props;
---

<div class="sm:hidden fixed inset-x-0 bottom-0 z-40 print:hidden">
  <a
    href={link}
    aria-label={text}
    class="flex items-center justify-center gap-2 w-full bg-amber hover:bg-amber-dark text-charcoal font-bold text-base px-4 py-3.5 shadow-[0_-4px_16px_rgba(0,0,0,0.25)]"
    style="padding-bottom: calc(0.875rem + env(safe-area-inset-bottom));"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-5 w-5 shrink-0"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="4" width="18" height="18" rx="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    {text}
  </a>
</div>
