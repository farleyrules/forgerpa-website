---
---

<form action="https://formspree.io/f/placeholder" method="POST" class="space-y-6" data-email="info@forgerpa.com">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="name" class="block text-sm font-medium text-gray-700 mb-2">Name</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber focus:border-amber outline-none transition-colors"
        placeholder="Your name"
      />
    </div>
    <div>
      <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber focus:border-amber outline-none transition-colors"
        placeholder="you@company.com"
      />
    </div>
  </div>
  <div>
    <label for="company" class="block text-sm font-medium text-gray-700 mb-2">Company</label>
    <input
      type="text"
      id="company"
      name="company"
      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber focus:border-amber outline-none transition-colors"
      placeholder="Your company"
    />
  </div>
  <div>
    <label for="message" class="block text-sm font-medium text-gray-700 mb-2">Message</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber focus:border-amber outline-none transition-colors resize-y"
      placeholder="Tell us about the processes you'd like to automate..."
    ></textarea>
  </div>

  {/*
    Clickwrap consent — attorney-required (2026-05-29 consult), mirrors the
    discovery-qualifier wizard. The checkbox is `required`, so native HTML
    form validation blocks submission until it's checked (no JS needed). The
    hidden fields record the document versions + literal assent text shown so
    the Formspree submission carries a consent record; Formspree additionally
    captures the submit timestamp + submitter IP server-side.
  */}
  <input type="hidden" name="consent_form_name" value="contact" />
  <input type="hidden" name="consent_terms_version" value="v1 (2026-06-01)" />
  <input type="hidden" name="consent_privacy_version" value="2026-06-01" />
  <input
    type="hidden"
    name="consent_assent_text"
    value="I have read and agree to the Terms & Conditions and Privacy Policy."
  />
  <div>
    <label class="flex items-start gap-3 cursor-pointer">
      <input
        type="checkbox"
        id="consent"
        name="consent_given"
        value="true"
        required
        class="mt-0.5 h-4 w-4 shrink-0 rounded border-gray-300 text-amber focus:ring-amber"
      />
      <span class="text-sm text-gray-700">
        I have read and agree to the
        <a
          href="/terms"
          target="_blank"
          rel="noopener"
          class="font-semibold text-amber-700 underline decoration-1 underline-offset-2 hover:text-amber-800"
          >Terms &amp; Conditions</a>
        and
        <a
          href="/privacy"
          target="_blank"
          rel="noopener"
          class="font-semibold text-amber-700 underline decoration-1 underline-offset-2 hover:text-amber-800"
          >Privacy Policy</a>.
        <span class="mt-1 block text-xs text-gray-500">Terms &amp; Conditions v1, effective June 1, 2026 &middot; Privacy Policy last updated June 1, 2026.</span>
      </span>
    </label>
  </div>

  <button
    type="submit"
    class="w-full sm:w-auto px-8 py-4 bg-amber hover:bg-amber-dark text-charcoal font-bold text-lg rounded-lg transition-colors shadow-lg shadow-amber/20"
  >
    Send Message
  </button>
</form>
