---
const navLinks = [
  { label: 'About', href: '/about' },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'Blog', href: '/blog' },
  { label: 'Resources', href: '/resources' },
  { label: 'Referral', href: '/referral' },
  { label: 'FAQ', href: '/faq' },
];

const serviceLinks = [
  { label: 'Automation Assessment', href: '/services/automation-assessment' },
  { label: 'Accounts Payable Automation', href: '/services/accounts-payable-automation' },
  { label: 'Treasury Automation', href: '/services/treasury-automation' },
  { label: 'Intelligent Document Processing', href: '/services/intelligent-document-processing' },
  { label: 'ERP Data Migration', href: '/services/erp-data-migration' },
  { label: 'SOP Automation', href: '/services/sop-automation' },
  { label: 'BPM Modernization', href: '/services/bpm-modernization' },
  { label: 'Process Mining', href: '/services/process-mining' },
  { label: 'Audit Automation', href: '/services/audit-automation' },
  { label: 'Data Lake', href: '/services/data-lake' },
];

const assessmentLinks = [
  { label: 'Month-End Close Assessment', href: '/services/month-end-close-assessment' },
  { label: 'AP Reconciliation Assessment', href: '/services/ap-reconciliation-assessment' },
  { label: 'ERP Handoff Assessment', href: '/services/erp-handoff-assessment' },
  { label: 'Quick Wins', href: '/services/quick-wins' },
];

const industryLinks = [
  { label: 'Overview', href: '/industries' },
  { label: 'Manufacturing Finance & Ops', href: '/industries/manufacturing-finance' },
  { label: 'Oil & Gas', href: '/industries/oil-gas' },
  { label: 'Healthcare Finance & Ops', href: '/industries/healthcare-finance' },
  { label: 'Insurance', href: '/industries/insurance-finance' },
  { label: 'Utilities', href: '/industries/utilities-finance' },
  { label: 'Small and Growing Businesses', href: '/industries/small-business' },
];
---

<header class="sticky top-0 z-50 bg-charcoal shadow-lg">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex shrink-0 items-center gap-2 text-amber hover:text-amber-light transition-colors">
        <!-- Anvil brand mark. alt is empty because the wordmark text beside it already names the link.
             It grows to the height of the two-line lockup wherever the descriptor shows, and drops
             back to the single-line size from lg to xl, where the descriptor is hidden. -->
        <img src="/anvil-mark.png" alt="" class="h-12 lg:h-9 xl:h-12 w-auto" />
        <!-- Wordmark plus the "AI-Built Automation" descriptor ("Forge RPA | AI-Built Automation").
             The descriptor is stacked beneath the wordmark, never inline: the desktop nav row has
             no spare width (an inline descriptor at 1440px squeezed the nav until "Case Studies"
             and "Contact Us" wrapped), and the stacked lockup is no wider than the wordmark.
             It is hidden only from lg to xl (1024-1279px), where the full desktop nav already
             fills the row and the logo has to give up width; below lg the nav is a hamburger.
             The descriptor spans the full width of the wordmark: its size, letter-spacing, and a
             small left inset (which offsets the side bearing of the wordmark's F) are tuned to Inter
             so the visible letters of both lines start and end on the same edges (David Farley,
             2026-10-13; measured within 2px in headless Chromium). items-start keeps each line at
             its own text width, so a font change that breaks the alignment shows up in a
             bounding-box check. -->
        <span class="flex flex-col items-start">
          <span class="text-3xl font-bold leading-none whitespace-nowrap">Forge RPA</span>
          <span class="mt-1.5 ml-[0.125em] text-sm font-medium leading-none tracking-[0.069em] whitespace-nowrap text-gray-300 lg:hidden xl:block">AI-Built Automation</span>
        </span>
      </a>

      <!-- Desktop Navigation. From lg to xl (1024-1279px) the links use tighter padding so the full
           row fits beside the logo on one line; from xl up they get the roomier spacing. -->
      <div class="hidden lg:flex items-center gap-1">
        <!-- Services Dropdown -->
        <div class="relative group">
          <a href="/services" class="flex items-center gap-1 px-1.5 xl:px-4 py-2 whitespace-nowrap text-gray-300 hover:text-white text-sm font-medium transition-colors">
            Services
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <div class="absolute left-0 top-full pt-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <div class="bg-charcoal-light rounded-lg shadow-xl border border-gray-700 py-2">
              {serviceLinks.map((link) => (
                <a href={link.href} class="block px-4 py-3 text-sm text-gray-300 hover:text-amber hover:bg-charcoal transition-colors">
                  {link.label}
                </a>
              ))}
              <div class="border-t border-gray-700 mt-2 pt-2">
                <p class="px-4 py-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Assessments</p>
                {assessmentLinks.map((link) => (
                  <a href={link.href} class="block px-4 py-3 text-sm text-gray-300 hover:text-amber hover:bg-charcoal transition-colors">
                    {link.label}
                  </a>
                ))}
              </div>
              <div class="border-t border-gray-700 mt-2 pt-2">
                <a href="/services" class="block px-4 py-3 text-sm text-amber hover:text-amber-light transition-colors font-medium">
                  View All Services
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Industries Dropdown -->
        <div class="relative group">
          <a href="/industries" class="flex items-center gap-1 px-1.5 xl:px-4 py-2 whitespace-nowrap text-gray-300 hover:text-white text-sm font-medium transition-colors">
            Industries
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <div class="absolute left-0 top-full pt-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <div class="bg-charcoal-light rounded-lg shadow-xl border border-gray-700 py-2">
              {industryLinks.map((link) => (
                <a href={link.href} class="block px-4 py-3 text-sm text-gray-300 hover:text-amber hover:bg-charcoal transition-colors">
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>

        {navLinks.map((link) => (
          <a href={link.href} class="px-1.5 xl:px-4 py-2 whitespace-nowrap text-gray-300 hover:text-white text-sm font-medium transition-colors">
            {link.label}
          </a>
        ))}

        <a href="/contact" class="ml-2 xl:ml-4 px-4 xl:px-5 py-2 whitespace-nowrap bg-amber hover:bg-amber-dark text-charcoal font-semibold text-sm rounded-lg transition-colors">
          Contact Us
        </a>
      </div>

      <!-- Mobile Hamburger -->
      <button id="mobile-menu-btn" class="lg:hidden text-gray-300 hover:text-white" aria-label="Toggle menu">
        <svg id="menu-open-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden lg:hidden pb-6">
      <div class="border-t border-gray-700 pt-4 space-y-1">
        <a href="/services" class="block px-4 py-3 text-gray-300 hover:text-amber font-medium">Services</a>
        <div class="pl-6 space-y-1">
          {serviceLinks.map((link) => (
            <a href={link.href} class="block px-4 py-2 text-sm text-gray-400 hover:text-amber">
              {link.label}
            </a>
          ))}
          {assessmentLinks.map((link) => (
            <a href={link.href} class="block px-4 py-2 text-sm text-gray-400 hover:text-amber">
              {link.label}
            </a>
          ))}
        </div>
        <a href="/industries" class="block px-4 py-3 text-gray-300 hover:text-amber font-medium">Industries</a>
        <div class="pl-6 space-y-1">
          {industryLinks.map((link) => (
            <a href={link.href} class="block px-4 py-2 text-sm text-gray-400 hover:text-amber">
              {link.label}
            </a>
          ))}
        </div>
        {navLinks.map((link) => (
          <a href={link.href} class="block px-4 py-3 text-gray-300 hover:text-amber font-medium">
            {link.label}
          </a>
        ))}
        <div class="pt-4 px-4 space-y-3">
          <a href="/contact" class="block w-full text-center px-5 py-3 bg-amber hover:bg-amber-dark text-charcoal font-semibold rounded-lg transition-colors">
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
