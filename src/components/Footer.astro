---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: 'Services', href: '/services' },
  { label: 'Industries', href: '/industries' },
  { label: 'About', href: '/about' },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'Blog', href: '/blog' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Contact Us', href: '/contact' },
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms & Conditions', href: '/terms' },
];

const serviceLinks = [
  { label: 'Automation Assessment', href: '/services/automation-assessment' },
  { label: 'ERP Data Migration', href: '/services/erp-data-migration' },
  { label: 'SOP Automation', href: '/services/sop-automation' },
  { label: 'Process Mining', href: '/services/process-mining' },
  { label: 'Data Lake', href: '/services/data-lake' },
  { label: 'Month-End Close Assessment', href: '/services/month-end-close-assessment' },
  { label: 'AP Reconciliation Assessment', href: '/services/ap-reconciliation-assessment' },
  { label: 'ERP Handoff Assessment', href: '/services/erp-handoff-assessment' },
  { label: 'Quick Wins', href: '/services/quick-wins' },
];
---

<footer class="bg-charcoal text-gray-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Brand Column -->
      <div>
        <a href="/" class="inline-flex items-center gap-2 text-2xl font-bold text-amber">
          <!-- Anvil brand mark. alt is empty because the wordmark text beside it already names the link. -->
          <img src="/anvil-mark.png" alt="" class="h-8 w-auto" />
          <span>Forge RPA</span>
        </a>
        <p class="mt-4 text-gray-400 leading-relaxed">
          Intelligent automation built by people who understand your operations.
        </p>
        <p class="mt-6 text-sm text-gray-500">
          &copy; {currentYear} Forge RPA. All rights reserved.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-semibold mb-4">Quick Links</h3>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-amber transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-white font-semibold mb-4">Get in Touch</h3>
        <ul class="space-y-3">
          <li>
            <a href="mailto:info@forgerpa.com" class="hover:text-amber transition-colors">
              info@forgerpa.com
            </a>
          </li>
          <li>Frisco, Texas</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <p class="text-center text-sm text-gray-500">
        We don't sell your personal information. See our
        <a href="/privacy" class="underline hover:text-amber transition-colors">Privacy Policy</a>
        for details on the cookies and analytics we use.
      </p>
    </div>
  </div>
</footer>
