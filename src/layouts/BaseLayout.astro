---
interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  /** When true, ask search engines not to index (e.g. form thank-you pages). */
  noindex?: boolean;
  /**
   * Absolute URL of the social-share image (1200x630 recommended). When set,
   * emits og:image + twitter:image and upgrades the Twitter card to a large
   * summary. When omitted, no image tags are emitted (no placeholder asset is
   * referenced) and the Twitter card stays a plain summary.
   */
  ogImage?: string;
}

const {
  title,
  description = 'Intelligent automation built by people who understand your operations. Process automation, ERP data migration, and AI-powered assessment.',
  canonicalUrl,
  noindex = false,
  ogImage,
} = Astro.props;
const siteUrl = 'https://forgerpa.com';
const canonical = canonicalUrl || Astro.url.href;
const ogImageResolved = ogImage || `${siteUrl}/og-default.png`;

// --- Tracking / verification env vars (Astro requires PUBLIC_ prefix for client-exposed values) ---
const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const gscVerificationToken = import.meta.env.PUBLIC_GSC_VERIFICATION_TOKEN;
const googleAdsConversionId = import.meta.env.PUBLIC_GOOGLE_ADS_CONVERSION_ID;

// --- JSON-LD Organization schema (site-wide) ---
// NOTE: `sameAs` is intentionally empty until a verified Forge RPA profile URL
// (e.g. the LinkedIn company page) is confirmed. Do not populate with a guessed URL.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://forgerpa.com/#organization',
  name: 'Forge RPA',
  legalName: 'Forge RPA LLC',
  url: 'https://forgerpa.com',
  logo: 'https://forgerpa.com/logo.png',
  description:
    'Forge RPA is a finance-led automation firm that builds intelligent automation for finance, accounting, and operations teams. Work includes month-end close automation, accounts payable, reconciliations, reporting, ERP data migration, process mining, and automation assessments, implemented around an organization\'s existing ERP and Microsoft 365 stack. Led by a 30-year finance and accounting practitioner who also builds the automation.',
  slogan: 'Automate the work. Keep the people.',
  email: 'info@forgerpa.com',
  areaServed: {
    '@type': 'Country',
    name: 'United States',
  },
  knowsAbout: [
    'Robotic Process Automation',
    'Month-End Close Automation',
    'Accounts Payable Automation',
    'Account Reconciliation Automation',
    'Financial Reporting Automation',
    'ERP Data Migration',
    'Process Mining',
    'Intelligent Document Processing',
    'Finance Transformation',
    'Microsoft 365 Automation',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'info@forgerpa.com',
    areaServed: 'US',
    availableLanguage: 'English',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Frisco',
    addressRegion: 'TX',
    addressCountry: 'US',
  },
  sameAs: [] as string[],
};

// --- JSON-LD ProfessionalService (a LocalBusiness subtype) for local/map signals.
//     Address is city/region only (Frisco, TX); no street is published since none
//     is shown publicly, so nothing is fabricated. ---
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Forge RPA',
  legalName: 'Forge RPA LLC',
  url: 'https://forgerpa.com',
  image: 'https://forgerpa.com/og-default.png',
  email: 'info@forgerpa.com',
  areaServed: 'US',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Frisco',
    addressRegion: 'TX',
    addressCountry: 'US',
  },
};

// --- BreadcrumbList: derive from canonical URL path. Only emit when depth >= 1. ---
function titleize(segment: string): string {
  return segment
    .split('-')
    .map((w) => (w.length ? w.charAt(0).toUpperCase() + w.slice(1) : w))
    .join(' ');
}

let breadcrumbSchema: Record<string, unknown> | null = null;
try {
  const canonicalPath = new URL(canonical).pathname;
  const segments = canonicalPath.split('/').filter((s) => s.length > 0);
  if (segments.length >= 1) {
    const itemListElement: Array<Record<string, unknown>> = [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: siteUrl + '/',
      },
    ];
    let acc = '';
    segments.forEach((seg, idx) => {
      acc += '/' + seg;
      itemListElement.push({
        '@type': 'ListItem',
        position: idx + 2,
        name: titleize(seg),
        item: siteUrl + acc,
      });
    });
    breadcrumbSchema = {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement,
    };
  }
} catch {
  // If canonical URL is malformed for any reason, skip breadcrumb schema rather than break the build.
  breadcrumbSchema = null;
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Forge RPA" />
  <meta property="og:image" content={ogImageResolved} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageResolved} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <title>{title} | Forge RPA</title>

  {/* Google Search Console verification */}
  {gscVerificationToken && (
    <meta name="google-site-verification" content={gscVerificationToken} />
  )}

  {/* Google Analytics 4 */}
  {ga4Id && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
      <script set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '${ga4Id}');
      `}></script>
    </>
  )}

  {/* Google Ads conversion tracking (shares dataLayer with GA4 when both present) */}
  {googleAdsConversionId && !ga4Id && (
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAdsConversionId}`}></script>
  )}
  {googleAdsConversionId && (
    <script set:html={`
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('config', '${googleAdsConversionId}');
    `}></script>
  )}

  {/* JSON-LD: Organization (site-wide) */}
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>

  {/* JSON-LD: ProfessionalService / LocalBusiness (site-wide) */}
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)}></script>

  {/* JSON-LD: BreadcrumbList (when on a sub-page) */}
  {breadcrumbSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  )}

  <style is:global>
    @import '../styles/global.css';
  </style>
</head>
<body class="bg-white text-gray-900 font-sans antialiased">
  <slot />
</body>
</html>
