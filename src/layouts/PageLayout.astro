---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import StickyBookCta from '../components/StickyBookCta.astro';

interface Props {
  title: string;
  description?: string;
  heroTitle?: string;
  heroSubtitle?: string;
  /** Optional small supporting line above the hero H1. */
  heroEyebrow?: string;
  /** Optional emphasized line under the hero subtitle. */
  heroTrustLine?: string;
  heroCta?: string;
  heroCtaLink?: string;
  noindex?: boolean;
  ogImage?: string;
  /** Optional link-preview extras, passed straight through to BaseLayout. */
  ogType?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogVideo?: { url: string; type: string; width: number; height: number };
  /** Mobile sticky "Book a call" bar. Shows on any page that has a heroCtaLink;
   *  pass false to suppress it (e.g. the booking page itself). */
  stickyCta?: boolean;
}

const { title, description, heroTitle, heroSubtitle, heroEyebrow, heroTrustLine, heroCta, heroCtaLink, noindex, ogImage, ogType, ogImageWidth, ogImageHeight, ogVideo, stickyCta = true } = Astro.props;
// Show the mobile sticky CTA only when the page actually has a booking target,
// so /book and the legal pages (which pass no heroCtaLink) never show it.
const showStickyCta = stickyCta !== false && Boolean(heroCtaLink);
---

<BaseLayout
  title={title}
  description={description}
  noindex={noindex}
  ogImage={ogImage}
  ogType={ogType}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  ogVideo={ogVideo}
>
  <Header />
  {heroTitle && (
    <Hero
      title={heroTitle}
      subtitle={heroSubtitle}
      eyebrow={heroEyebrow}
      trustLine={heroTrustLine}
      ctaText={heroCta}
      ctaLink={heroCtaLink}
    />
  )}
  <main class={showStickyCta ? 'pb-16 sm:pb-0' : ''}>
    <slot />
  </main>
  <Footer />
  {showStickyCta && <StickyBookCta link={heroCtaLink} />}
</BaseLayout>
