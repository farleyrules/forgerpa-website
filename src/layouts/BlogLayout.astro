---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  author?: string;
  date?: string;
  /** Last-substantive-update date. Drives JSON-LD dateModified; falls back to `date`. */
  updated?: string;
  tags?: string[];
  readingTime?: string;
}

const { title, description, author = 'David Farley', date, updated, tags = [], readingTime = '8 min' } = Astro.props;

// Normalize a frontmatter value (string "YYYY-MM-DD" or Date) to an ISO date string (YYYY-MM-DD).
function toIsoDate(value: string | Date | undefined): string | undefined {
  if (!value) return undefined;
  if (value instanceof Date) return value.toISOString().slice(0, 10);
  return value;
}

const publishedIso = toIsoDate(date);
const modifiedIso = toIsoDate(updated) || publishedIso;

const formattedDate = publishedIso ? new Date(publishedIso + 'T00:00:00').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}) : '';

// Canonical URL for this post (strip any query/hash so the @id is stable).
const canonicalHref = new URL(Astro.url.pathname, 'https://forgerpa.com').href;

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Forge RPA',
    logo: {
      '@type': 'ImageObject',
      url: 'https://forgerpa.com/logo.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalHref,
  },
  url: canonicalHref,
  image: 'https://forgerpa.com/og-default.png',
  ...(publishedIso ? { datePublished: publishedIso } : {}),
  ...(modifiedIso ? { dateModified: modifiedIso } : {}),
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  <Header />
  <main class="py-16 lg:py-24">
    <article class="max-w-3xl mx-auto px-4 sm:px-6">
      <header class="mb-12">
        <div class="flex flex-wrap gap-2 mb-4">
          {tags.map((tag) => (
            <a href={`/blog/tags/${encodeURIComponent(tag)}`} class="text-xs font-medium px-3 py-1 bg-amber/10 text-amber-dark rounded-full hover:bg-amber/20 transition-colors">
              {tag}
            </a>
          ))}
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-charcoal leading-tight mb-6">
          {title}
        </h1>
        <div class="flex items-center gap-4 text-gray-500 text-sm">
          <span class="font-medium text-charcoal">{author}</span>
          <span>|</span>
          <time datetime={date}>{formattedDate}</time>
          <span>|</span>
          <span>{readingTime} read</span>
        </div>
      </header>
      <div class="blog-content max-w-none">
        <slot />
      </div>
      <footer class="mt-16 pt-8 border-t border-gray-200">
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a href={`/blog/tags/${encodeURIComponent(tag)}`} class="text-sm px-4 py-2 border border-gray-300 rounded-full text-gray-600 hover:border-amber hover:text-amber-dark transition-colors">
              {tag}
            </a>
          ))}
        </div>
      </footer>
    </article>
  </main>
  <Footer />
</BaseLayout>
