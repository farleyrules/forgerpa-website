---
import PageLayout from '../layouts/PageLayout.astro';
import ProofBar from '../components/ProofBar.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import CTASection from '../components/CTASection.astro';
import { getCollection } from 'astro:content';
const featuredStudies = await getCollection('case-studies', ({ data }) => data.featured === true);
const sortedFeatured = featuredStudies
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999))
  .slice(0, 3);
---

<PageLayout
  title="Finance & Operations Automation | Forge RPA"
  description="Practical automation for finance, accounting, and operations teams. We help organizations eliminate manual work in month-end close, AP, reconciliations, reporting, and governed operational handoffs that feed the ledger."
  heroTitle="Finance and Operations Automation, Built Around Your Process"
  heroSubtitle="We're a finance-led automation team, headed by a 30-year accounting practitioner who also builds the automation. Most vendors have finance clients but have never closed a book; most people who have lived the close don't write the code. We do both. We strip the manual data-movement out of month-end close, AP, reconciliations, intercompany, and reporting, so the judgment work stays with your team and the swivel-chair work goes away. The same discipline carries into operations and administrative flows when they're rules-based and systems-accessible."
  heroCta="Get Your Time Back"
  heroCtaLink="/contact"
>
  <!-- Proof Bar -->
  <ProofBar />

  <!-- Services Section -->
  <section class="py-20 lg:py-28 bg-slate-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-charcoal">What We Build</h2>
        <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
          Finance and accounting automation first, with the same rigor applied to the operations and administrative work that feeds the ledger. From a quick assessment to a full build, we take the repetitive, error-prone work off your team's plate, whether you're a growing business or an established enterprise.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <ServiceCard
          icon="📊"
          title="Automation Assessment"
          description="Data-driven process scoring and ROI projections for finance, accounting, and operations teams. Our framework identifies which processes will deliver the fastest return."
          link="/services/automation-assessment"
        />
        <ServiceCard
          icon="🔄"
          title="ERP Data Migration"
          description="Reliable data conversion for Workday, NetSuite, SAP and other systems. Reconciliation-verified accuracy with minimal disruption."
          link="/services/erp-data-migration"
        />
        <ServiceCard
          icon="⚙️"
          title="Finance and Operations Process Automation"
          description="Our proprietary framework rapidly transforms complex finance and adjacent operations processes into reliable, self-improving automation with built-in governance and documentation."
          link="/services/sop-automation"
        />
        <ServiceCard
          icon="🔍"
          title="Process Mining"
          description="Data-driven discovery of how your finance and operations processes actually work. Our framework identifies bottlenecks, exceptions, and high-ROI automation opportunities from real transaction and event data."
          link="/services/process-mining"
        />
      </div>
    </div>
  </section>

  <!-- Featured Case Studies -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-charcoal mb-4">What Good Looks Like</h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">Representative outcomes from three decades of finance automation work, and the patterns we build toward.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {sortedFeatured.map((study) => (
          <CaseStudyCard
            industry={study.data.industry}
            metric={study.data.metric || study.data.summary}
            description={study.data.shortDescription || study.data.summary}
            link={`/case-studies/${study.slug}`}
          />
        ))}
      </div>
      
      <div class="text-center mt-12">
        <a href="/case-studies" class="inline-flex items-center gap-2 text-amber-dark hover:text-amber font-semibold">
          View All Case Studies
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-charcoal">Industries We Serve</h2>
        <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
          Finance-grade automation with clear audit trails, plus operations handoffs that feed the ledger. Explore by industry or small business; every org still has core A&amp;F and ops pain we can map on a call.
        </p>
        <a href="/industries" class="inline-flex mt-6 text-amber-dark hover:text-amber font-semibold">
          View All Industry Pages →
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        <a href="/industries/manufacturing-finance" class="block rounded-2xl border border-gray-100 bg-white p-6 hover:border-amber transition-colors">
          <h3 class="text-lg font-bold text-charcoal mb-2">Manufacturing Finance &amp; Ops</h3>
          <p class="text-sm text-gray-600">Plant close, cost rolls, BOM and WIP variance, inventory valuation, shop-floor-to-GL.</p>
        </a>
        <a href="/industries/oil-gas" class="block rounded-2xl border border-gray-100 bg-white p-6 hover:border-amber transition-colors">
          <h3 class="text-lg font-bold text-charcoal mb-2">Oil &amp; Gas</h3>
          <p class="text-sm text-gray-600">Finance, JVs, and operations handoffs (materials, field, logistics).</p>
        </a>
        <a href="/industries/healthcare-finance" class="block rounded-2xl border border-gray-100 bg-white p-6 hover:border-amber transition-colors">
          <h3 class="text-lg font-bold text-charcoal mb-2">Healthcare Finance &amp; Ops</h3>
          <p class="text-sm text-gray-600">Non-PHI finance and adjacent ops (supplies, facilities feeds).</p>
        </a>
        <a href="/industries/insurance-finance" class="block rounded-2xl border border-gray-100 bg-white p-6 hover:border-amber transition-colors">
          <h3 class="text-lg font-bold text-charcoal mb-2">Insurance</h3>
          <p class="text-sm text-gray-600">Finance, claims ops files, and underwriting support assembly.</p>
        </a>
        <a href="/industries/utilities-finance" class="block rounded-2xl border border-gray-100 bg-white p-6 hover:border-amber transition-colors">
          <h3 class="text-lg font-bold text-charcoal mb-2">Utilities</h3>
          <p class="text-sm text-gray-600">Close, work orders, field events, and regulatory extracts.</p>
        </a>
        <a href="/industries/small-business" class="block rounded-2xl border border-gray-100 bg-white p-6 hover:border-amber transition-colors">
          <h3 class="text-lg font-bold text-charcoal mb-2">Small and Growing Businesses</h3>
          <p class="text-sm text-gray-600">Assessment first, per-solution builds, optional retainer without an IT bench.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Signals -->
  <section class="py-16 bg-slate-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl font-semibold text-charcoal">Proven in Finance &amp; Operations</h2>
        <p class="text-gray-600 mt-3">Thirty years closing books, building reconciliations, and owning the month-end crunch, paired with the rarer ability to build the automation in-house. One example: a recurring intercompany journal-entry process across multiple companies that took roughly 40 hours a cycle now runs in 20 to 30 minutes, with the judgment work still owned by the team.</p>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl font-bold text-amber mb-2">30+</div>
          <div class="text-sm text-gray-600">Years in Finance & Operations</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-amber mb-2">Fortune Global 500</div>
          <div class="text-sm text-gray-600">Manufacturing & Industrial Companies</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-amber mb-2">Multiple Industries</div>
          <div class="text-sm text-gray-600">Utilities, Healthcare & Insurance</div>
        </div>
        <div>
          <div class="text-4xl font-bold text-amber mb-2">100+</div>
          <div class="text-sm text-gray-600">Finance &amp; Ops Automations Delivered</div>
        </div>
      </div>
      
      <div class="text-center mt-12 text-sm text-gray-500 max-w-2xl mx-auto">
        Extensive experience with SAP, Workday, NetSuite, Ariba, Lawson, Hyperion, 
        and advanced Excel, VBA & Power Query solutions, now enhanced with modern automation approaches.
      </div>
    </div>
  </section>

  <CTASection
    heading="Ready to Reduce Manual Finance &amp; Operations Work?"
    subtext="Book a 30-minute discovery call to discuss priorities, scope, and timing for finance and operations automation."
    ctaText="Start the Conversation"
    ctaLink="/contact"
  />
</PageLayout>
