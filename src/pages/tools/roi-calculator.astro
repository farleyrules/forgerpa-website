---
import PageLayout from '../../layouts/PageLayout.astro';
import CTASection from '../../components/CTASection.astro';
import RoiCalculator from '../../components/RoiCalculator.astro';

// The calculator itself lives in the reusable RoiCalculator component so this
// standalone page and the inline embeds on the finance services pages share one
// source of truth for the model, the inputs, and the scenario presets. This page
// renders it in full mode (scenario selector + optional email capture shown); a
// services page renders it compact and pre-set to a single scenario. The initial
// scenario here still honors a ?scenario=ap|reconciliations|month-end-close deep
// link, resolved inside the component's script.
---

<PageLayout
  title="Finance Automation ROI Calculator"
  description="A free, interactive ROI calculator for finance and operations automation. Pick a scenario, enter hours removed, loaded cost, adoption, and implementation spend, and see monthly savings, annual savings, year-one net, three-year and five-year cumulative net, and simple payback. No email required."
  heroTitle="Finance Automation ROI Calculator"
  heroSubtitle="Pick what you are automating, enter your numbers, and see the return live. Hours removed, loaded cost, adoption, implementation spend, and annual run-state, turned into monthly savings, annual savings, year-one net, three-year and five-year cumulative net, and simple payback. No sign-up, no email wall. Just the math."
  heroCta="Book a Discovery Call"
  heroCtaLink="/contact?from=roi-calculator"
>
  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Full-mode calculator: preset selector + optional email capture. -->
      <RoiCalculator />

      <!-- Honest disclaimer. -->
      <div class="mt-10 border-t border-gray-200 pt-6">
        <p class="text-sm text-gray-500 leading-relaxed">
          These outputs are illustrative estimates, not a quote or a guarantee. They use a simple labor-savings model
          and your own inputs, and they assume the savings hold steady each year. Real results depend on process fit,
          data quality, adoption, and the specifics of your environment. Use this to frame a conversation, not to set a
          budget. When you are ready for a grounded number, book a call and we will scope it against your actual work.
        </p>
      </div>

    </div>
  </section>

  <CTASection
    heading="Want a Grounded Number for Your Own Process?"
    subtext="Book a free 30-minute discovery call. We will walk through the work you want to automate, the hours it really takes, and where the payback lands. You leave with a clearer picture even if we never work together."
    ctaText="Book a Discovery Call"
    ctaLink="/contact?from=roi-calculator"
  />
</PageLayout>
