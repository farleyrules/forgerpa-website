---
/**
 * /demos/watch/?r=<token>: a demo video made for one prospect (David, 2026-11-25).
 *
 * This repo is public, so nothing that names a prospect is ever built into it: not the video,
 * the poster, the title or the slug. The page is a generic shell. Its script reads the token
 * from ?r=, asks the sales cockpit what the link plays (DEMO_RESOLVE_URL in
 * src/data/demo-tracking.ts), then fills in the title, audience, description, poster and
 * video, which stream from the cockpit, and only then starts the same tracked-link beacons
 * the /demos/<slug>/ pages send, with the slug the lookup returned.
 *
 * States (data-watch-state on the section, for tests and the live check):
 *   loading   while the lookup runs
 *   ready     the video is shown and tracking has started
 *   inactive  no token, a malformed token, or the cockpit answered 404 (unknown or revoked)
 *   error     the lookup failed (network, timeout, a non-404 error, or an unexpected answer);
 *             Try Again repeats it
 *
 * Unlike /demos/<slug>/, the token stays in the address bar: it is the only key to the video,
 * so a reload must still work. The Google tags get the address without it (BaseLayout's
 * page_location), and the strict-origin referrer policy keeps it out of the next page's
 * document.referrer. One person, one link: no Copy Link, no Up Next, no end card.
 *
 * Kept off every list: noindex, excluded from the sitemap (astro.config.mjs), absent from
 * src/data/demos.ts and /demos/demos.json, and linked from no page.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import CTASection from '../../components/CTASection.astro';
import DemoTracking from '../../components/DemoTracking.astro';
import { DEMO_RESOLVE_URL, DEMO_TOKEN_PATTERN } from '../../data/demo-tracking';

const secondaryLink =
  'inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-300 bg-white text-sm font-semibold text-charcoal hover:border-amber transition-colors';
---

<PageLayout title="Demo Video" description="A Forge RPA demo video." noindex={true} referrerPolicy="strict-origin">
  <section class="py-12 lg:py-16" data-watch data-watch-state="loading">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/demos/" class="inline-flex items-center gap-1 text-sm font-semibold text-amber-dark hover:text-amber transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        All Demos
      </a>

      <div class="mt-4 overflow-hidden rounded-2xl border border-gray-200 bg-charcoal" data-watch-frame>
        <div class="relative" data-demo-stage>
          <!-- Filled in by the script below once the cockpit answers. No crossorigin attribute:
               the cockpit's media routes check the token, not CORS. -->
          <video
            class="block w-full aspect-video bg-charcoal"
            controls
            preload="none"
            playsinline
            width="1920"
            height="1080"
            aria-labelledby="demo-title"
            hidden
            data-demo-player
          ></video>
          <div class="flex w-full aspect-video items-center justify-center" role="status" data-watch-loading>
            <span class="h-10 w-10 rounded-full border-4 border-white/20 border-t-amber animate-spin" aria-hidden="true"></span>
            <span class="sr-only">Loading the video.</span>
          </div>
        </div>
      </div>

      <div class="mt-6">
        <div class="flex items-start justify-between gap-4">
          <h1 id="demo-title" class="sr-only text-3xl sm:text-4xl font-extrabold text-charcoal leading-tight" data-watch-heading>Loading Video</h1>
          <time
            class="mt-1.5 shrink-0 rounded-full bg-slate-light border border-gray-200 px-2.5 py-0.5 text-sm font-medium text-gray-600 tabular-nums"
            hidden
            data-watch-duration
          ></time>
        </div>
        <p class="mt-2 text-sm font-semibold text-amber-dark" hidden data-watch-audience></p>
        <p class="mt-3 max-w-3xl text-lg text-gray-600 leading-relaxed" hidden data-watch-description></p>

        <div hidden data-watch-message>
          <p class="mt-3 max-w-3xl text-lg text-gray-600 leading-relaxed" data-watch-message-text></p>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <button
              type="button"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-amber hover:bg-amber-dark text-sm font-bold text-charcoal transition-colors cursor-pointer"
              hidden
              data-watch-retry
            >
              Try Again
            </button>
            <a href="/demos/" class={secondaryLink}>Browse All Demos</a>
            <a href="/contact" class={secondaryLink}>Contact Us</a>
          </div>
        </div>

        <noscript>
          <p class="mt-3 max-w-3xl text-lg text-gray-600 leading-relaxed">This video needs JavaScript to play. Turn it on and reload the page.</p>
        </noscript>
      </div>
    </div>
  </section>

  <div hidden data-watch-cta>
    <CTASection
      heading="See it on your process"
      subtext="Tell us about the process that takes up your team's week. We will show you what it looks like automated."
    />
  </div>

  <!-- Tracked demo link beacons, started by the script below with the slug the cockpit
       returned. The token stays in the address bar here (stripToken false). -->
  <DemoTracking stripToken={false} />

  <script
    is:inline
    define:vars={{
      resolveUrl: DEMO_RESOLVE_URL,
      tokenPattern: DEMO_TOKEN_PATTERN,
    }}
  >
    (function () {
      var section = document.querySelector('[data-watch]');
      var frame = document.querySelector('[data-watch-frame]');
      var loading = document.querySelector('[data-watch-loading]');
      var video = document.querySelector('video[data-demo-player]');
      var heading = document.querySelector('[data-watch-heading]');
      var durationBadge = document.querySelector('[data-watch-duration]');
      var audience = document.querySelector('[data-watch-audience]');
      var description = document.querySelector('[data-watch-description]');
      var message = document.querySelector('[data-watch-message]');
      var messageText = document.querySelector('[data-watch-message-text]');
      var retry = document.querySelector('[data-watch-retry]');
      var cta = document.querySelector('[data-watch-cta]');
      if (!section || !video || !heading) return;

      var SLUG_PATTERN = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
      var TIMEOUT_MS = 15000;
      var token = new URLSearchParams(location.search).get('r');
      var tokenIsValid = !!token && new RegExp(tokenPattern).test(token);

      function setState(state) {
        section.setAttribute('data-watch-state', state);
      }

      function showLoading() {
        setState('loading');
        message.hidden = true;
        frame.hidden = false;
        loading.hidden = false;
        heading.classList.add('sr-only');
        heading.textContent = 'Loading Video';
      }

      // kind: 'inactive' (no such live link) or 'error' (the lookup itself failed).
      function showMessage(kind) {
        setState(kind);
        frame.hidden = true;
        heading.textContent = 'Video Unavailable';
        heading.classList.remove('sr-only');
        messageText.textContent =
          kind === 'inactive'
            ? 'This video link is no longer active.'
            : 'The video could not be loaded. Check your connection and try again.';
        retry.hidden = kind !== 'error';
        message.hidden = false;
      }

      function isHttpsUrl(value) {
        if (typeof value !== 'string') return false;
        try {
          return new URL(value).protocol === 'https:';
        } catch (e) {
          return false;
        }
      }
      function text(value) {
        return typeof value === 'string' ? value.trim() : '';
      }

      // The cockpit's answer, checked before anything from it reaches the page. Every field is
      // written with textContent or as a URL attribute, never as HTML.
      function readVideo(body) {
        if (!body || body.version !== 1) return null;
        if (typeof body.slug !== 'string' || !SLUG_PATTERN.test(body.slug)) return null;
        if (!text(body.title)) return null;
        if (!isHttpsUrl(body.videoUrl) || !isHttpsUrl(body.posterUrl)) return null;
        var seconds = body.durationSeconds;
        return {
          slug: body.slug,
          title: text(body.title),
          audience: text(body.audience),
          description: text(body.description),
          durationSeconds: typeof seconds === 'number' && isFinite(seconds) && seconds > 0 ? seconds : 0,
          videoUrl: body.videoUrl,
          posterUrl: body.posterUrl,
        };
      }

      // Same labels as src/data/demos.ts formatDuration and isoDuration (whole seconds, rounded).
      function clock(seconds) {
        var total = Math.round(seconds);
        return Math.floor(total / 60) + ':' + String(total % 60).padStart(2, '0');
      }
      function isoDuration(seconds) {
        var total = Math.round(seconds);
        var m = Math.floor(total / 60);
        return 'PT' + (m > 0 ? m + 'M' : '') + (total % 60) + 'S';
      }

      function ignoreRejection(promise) {
        if (promise && typeof promise.catch === 'function') promise.catch(function () {});
      }

      // The play button over the poster, the same treatment as the /demos/<slug>/ pages.
      function addPlayButton(title) {
        video.removeAttribute('controls');
        var playButton = document.createElement('button');
        playButton.type = 'button';
        playButton.className =
          'group absolute inset-0 flex items-center justify-center cursor-pointer focus:outline-none';
        playButton.setAttribute('aria-label', 'Play ' + title);
        playButton.innerHTML =
          '<span class="flex h-16 w-16 sm:h-20 sm:w-20 items-center justify-center rounded-full bg-amber text-white shadow-lg shadow-black/30 transition group-hover:bg-amber-dark group-hover:scale-105 group-focus-visible:ring-4 group-focus-visible:ring-charcoal group-focus-visible:ring-offset-2 group-focus-visible:ring-offset-white">' +
          '<svg class="ml-1 h-8 w-8 sm:h-10 sm:w-10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l10.6-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14z"/></svg>' +
          '</span>';
        function start() {
          playButton.remove();
          video.setAttribute('controls', '');
        }
        playButton.addEventListener('click', function () {
          start();
          video.focus({ preventScroll: true });
          ignoreRejection(video.play());
        });
        // Playback started some other way (a media key): the overlay goes, the controls return.
        video.addEventListener('play', start, { once: true });
        video.parentElement.appendChild(playButton);
      }

      function showVideo(found) {
        heading.textContent = found.title;
        heading.classList.remove('sr-only');
        if (found.durationSeconds > 0) {
          durationBadge.textContent = clock(found.durationSeconds);
          durationBadge.setAttribute('datetime', isoDuration(found.durationSeconds));
          durationBadge.hidden = false;
        }
        if (found.audience) {
          audience.textContent = found.audience;
          audience.hidden = false;
        }
        if (found.description) {
          description.textContent = found.description;
          description.hidden = false;
        }
        video.setAttribute('data-demo-title', found.title);
        video.poster = found.posterUrl;
        video.src = found.videoUrl;
        loading.hidden = true;
        video.hidden = false;
        addPlayButton(found.title);
        if (cta) cta.hidden = false;
        setState('ready');
        // Tracking starts only now, with the slug the cockpit returned (DemoTracking.astro).
        if (window.forgeDemoTracking) window.forgeDemoTracking.start(found.slug, found.durationSeconds);
      }

      function resolve() {
        showLoading();
        var controller = typeof AbortController === 'function' ? new AbortController() : null;
        var timer = setTimeout(function () {
          if (controller) controller.abort();
        }, TIMEOUT_MS);
        // A simple GET (no custom headers, so no preflight) and no cookies: the lookup records
        // nothing, and the cockpit's CORS answer needs no credentials.
        fetch(resolveUrl + '?r=' + encodeURIComponent(token), {
          method: 'GET',
          mode: 'cors',
          credentials: 'omit',
          cache: 'no-store',
          signal: controller ? controller.signal : undefined,
        })
          .then(function (res) {
            if (res.status === 404) return { kind: 'inactive' };
            if (!res.ok) return { kind: 'error' };
            return res.json().then(function (body) {
              var found = readVideo(body);
              return found ? { kind: 'ready', video: found } : { kind: 'error' };
            });
          })
          .catch(function () {
            return { kind: 'error' };
          })
          .then(function (result) {
            clearTimeout(timer);
            if (result.kind === 'ready') showVideo(result.video);
            else showMessage(result.kind);
          });
      }

      if (!tokenIsValid) {
        showMessage('inactive');
        return;
      }
      retry.addEventListener('click', resolve);
      resolve();
    })();
  </script>
</PageLayout>
