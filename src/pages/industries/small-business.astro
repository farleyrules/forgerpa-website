---
import IndustrySolutions from '../../components/IndustrySolutions.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Small and Growing Business Automation',
  serviceType: 'Small Business Finance and Operations Automation',
  description:
    'Finance-grade automation scoped for small and growing businesses without a large IT shop: an assessment first, builds priced per solution or phase, and an optional retainer to run, monitor, and extend the automation Hub without adding headcount.',
  provider: {
    '@type': 'Organization',
    name: 'Forge RPA LLC',
    url: 'https://forgerpa.com',
  },
  areaServed: {
    '@type': 'Country',
    name: 'United States',
  },
  url: 'https://forgerpa.com/industries/small-business',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do we need a dedicated IT or automation team to work with you?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. This is built for teams without dedicated automation IT who still need reliable, documented runs. If you do not have IT to operate the automation Hub and schedules, an optional monthly retainer covers monitoring, small fixes, and prioritization. You get the same finance-grade discipline larger enterprises use, scoped to your team.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does pricing work for a smaller business?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A typical path is a fixed-price automation assessment so you know ROI and sequence before you spend on builds, then per-solution or phased development so each go-live is budgeted, and an optional monthly retainer if you want us to run, monitor, and extend the Hub. You request additional automations as separate scoped fees when ready. We scale the same rate logic we use for larger clients to your scope and budget.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which processes do you automate for small and growing businesses?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Month-end, AP, and cash discipline (vendor bills, light three-way match, payment batches, cash application from bank files, close checklists), order-to-cash and invoicing hygiene, reporting packs owners actually read, and light governance you can defend. On the operations side: vendor and customer onboarding packets, inventory and fulfillment interfaces where volume warrants, and non-HR-core scheduling and operations admin.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which systems do you work with?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Common SMB stacks including QuickBooks Online, NetSuite, Microsoft 365, Google Workspace, Shopify, ServiceTitan-class tools, and industry vertical SaaS, plus the Excel that still runs half the company. Discovery confirms which systems are authoritative before we wire anything together.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are you a CPA firm or tax advisor?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. We are not a CPA firm, law firm, or tax advisor. You remain responsible for filings, payroll law, and system-of-record decisions. We build controlled, documented automation around the rules you supply, with the finance-grade discipline that comes from a deep finance and accounting background.',
      },
    },
    {
      '@type': 'Question',
      name: 'What happens when staff turns over?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Every automation ships with logging, rerun instructions, and short runbooks, so when staff turns over the next person is not reverse-engineering a macro. That documented, defensible approach is the point: you get evidence and reliable reruns rather than fragile spreadsheets only one person understands.',
      },
    },
  ],
};
---

<IndustrySolutions
  serviceSchema={serviceSchema}
  faqSchema={faqSchema}
  title="Small and Growing Business Automation | Forge RPA"
  metaDescription="Automation for SMBs: accounting and operations without a large IT shop, assessment first, fixed builds per solution, optional retainer for ongoing support and Hub operations."
  heroTitle="Small and Growing Businesses"
  heroSubtitle="You get the same finance-grade discipline larger enterprises use, scoped for your team. We fit how you buy: a clear assessment, development priced per solution or phase, and an optional retainer when you want us to run, monitor, and extend the Hub without adding headcount."
  audience={[
    'Owners, CFOs, and controllers at companies roughly $5M–$150M revenue (flexible)',
    'Operations leads who live in Excel, QuickBooks, NetSuite, Shopify, or industry SaaS',
    'Teams without dedicated automation IT who still need reliable, documented runs',
  ]}
  pains={[
    {
      title: 'Month-End, AP, and Cash Discipline',
      body:
        'Vendor bills, three-way match light, payment batches, cash application from bank files, and close checklists, fewer spreadsheets that only one person understands.',
    },
    {
      title: 'Order-to-Cash and Invoicing Hygiene',
      body:
        'Pulling orders from e-commerce or CRM, generating or validating invoices, gentle reminders, and exception lists for the person who approves exceptions.',
    },
    {
      title: 'Reporting Packs Owners Actually Read',
      body:
        'Recurring management reports from QuickBooks / NetSuite / exports with variance commentary templates, not a black-box “AI”; transparent tables you can audit.',
    },
    {
      title: 'Light Governance You Can Defend',
      body:
        'Logging, rerun instructions, and short runbooks so when staff turns over, the next person is not reverse-engineering a macro.',
    },
  ]}
  operationsPains={[
    {
      title: 'Vendor and Customer Onboarding Packets',
      body:
        'Collecting W-9 / certificate data from forms or email, naming conventions, and loading structured rows into accounting or CRM, reducing “swivel chair” between inboxes and systems.',
    },
    {
      title: 'Inventory and Fulfillment Interfaces (Where Volume Warrants)',
      body:
        'Scheduled reconciliations between Shopify (or similar), 3PL CSVs, and your ledger view, scoped when SKUs and transaction volume justify automation over manual.',
    },
    {
      title: 'Scheduling and Operations Admin (Non-HR-Core)',
      body:
        'Consolidating crew or job schedules into billing-ready summaries, or turning operational exports into finance-ready cutoffs, only where data stays non-PHI and finance-owned.',
    },
  ]}
  systemsBlurb="We meet you where you are: common SMB stacks (QuickBooks Online, NetSuite, Microsoft 365, Google Workspace, Shopify, ServiceTitan-class tools, industry vertical SaaS) plus the Excel that still runs half the company. Discovery confirms which systems are authoritative before we wire anything."
  proofBlurb="A typical path: (1) fixed-price automation assessment so you know ROI and sequence before you spend on builds. (2) Per-solution or phased development so each go-live is budgeted. (3) If you do not have IT to operate the Hub and schedules, a monthly retainer covers monitoring, small fixes, and prioritization, you request additional automations as separate scoped fees when ready. Exact numbers follow the same rate logic as larger clients, scaled to scope, book a call and we will align to your budget."
  disclaimer="We are not a CPA firm, law firm, or tax advisor. You remain responsible for filings, payroll law, and system-of-record decisions; we build controlled automation around the rules you supply."
  bookingSource="industries-small-business"
  valueHeading="Why this matters for smaller teams"
  valueBullets={[
    'You still deserve **evidence and reruns**, not fragile macros, without hiring a full RPA COE.',
    'Buying should be **incremental**: assess → one win → retainer or next build, not a seven-figure platform gamble.',
    'The same **Hub + documentation** pattern we use at enterprise scales down when we keep scope honest.',
  ]}
/>
