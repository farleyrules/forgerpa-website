<!-- Existing `?from=` context-banner machinery — PRESERVED. Runs independently of the wizard. -->
<script is:inline>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var from = (params.get('from') || '').toLowerCase().trim();

    function setMetaDescription(text) {
      var m = document.querySelector('meta[name="description"]');
      if (m) m.setAttribute('content', text);
      var og = document.querySelector('meta[property="og:description"]');
      if (og) og.setAttribute('content', text);
      var tw = document.querySelector('meta[name="twitter:description"]');
      if (tw) tw.setAttribute('content', text);
    }

    function setOgTitle(text) {
      var og = document.querySelector('meta[property="og:title"]');
      if (og) og.setAttribute('content', text);
      var tw = document.querySelector('meta[name="twitter:title"]');
      if (tw) tw.setAttribute('content', text);
    }

    // NOTE: the hero headline is governed by the single HERO_HEADLINE constant
    // in this page's frontmatter (single-intent positioning). The `?from=`
    // machinery below sets only the document title, meta description, and the
    // context banner — it intentionally does NOT override the hero <h1>.
    function industryContext(fromKey) {
      if (!fromKey || fromKey.indexOf('industries-') !== 0) return null;
      var slug = fromKey.replace(/^industries-/, '').replace(/-/g, ' ');
      var pretty = {
        'oil gas': 'Oil & Gas',
        'healthcare finance': 'Healthcare Finance & Ops (non-PHI)',
        'insurance finance': 'Insurance finance',
        'utilities finance': 'Utilities & infrastructure finance',
        'small business': 'Small and Growing Businesses',
        overview: 'Industries overview',
      }[slug];
      var label = pretty || slug.replace(/\b\w/g, function (c) { return c.toUpperCase(); });
      return {
        title: 'Contact us',
        description:
          'Tell us what you would like automated. We will connect your industry context to concrete finance and operations automation opportunities.',
        banner: 'You arrived from a Forge RPA industry page (' + label + '). We will use that lens for examples and questions, then confirm fit before any larger commitment.',
      };
    }

    var contexts = {
      assessment: { title: 'Contact us about an assessment', banner: 'You arrived from Automation Assessment. We will prioritize fit, scope, and what a three-week assessment would cover for your environment.' },
      sop: { title: 'Contact us about your SOPs', banner: 'You arrived from Finance Process Automation. We will emphasize SOP intake, delivery expectations, and how we scope build and handoff.' },
      'process-mining': { title: 'Contact us about process mining', banner: 'You arrived from Process Mining. We will focus on data sources, timelines, and what a mining engagement typically surfaces for finance and operations teams.' },
      migration: { title: 'Contact us about a migration', banner: 'You arrived from ERP Data Migration. We will emphasize conversion risk, validation approach, and what information we need to scope accurately.' },
      'data-lake': { title: 'Contact us about a data lake', banner: 'You arrived from Data Lake. We will focus on source systems, schema planning, and how reporting consolidation drops out of a well-built lake.' },
      'month-end-close-assessment': { title: 'Contact us about month-end close', banner: 'You arrived from Month-End Close Assessment. We will focus on the specific subroutines (recs, accruals, reporting) where automation pays off fastest.' },
      'ap-reconciliation-assessment': { title: 'Contact us about AP / reconciliation', banner: 'You arrived from AP / Reconciliation Assessment. We will focus on invoice flow, three-way match, and reconciliation cycles.' },
      'erp-handoff-assessment': { title: 'Contact us about an ERP handoff', banner: 'You arrived from ERP Handoff Assessment. We will focus on Workday / NetSuite / SAP integration points and where the manual cracks are.' },
      'oil-gas-diagnostic': { title: 'Contact us about oil & gas operations', banner: 'You arrived from Oil & Gas Diagnostic. We will focus on JIB, AFE, and lease-operating workflows.' },
    };

    var ctx = contexts[from] || industryContext(from);

    if (ctx) {
      var fullTitle = (ctx.title || 'Contact Us') + ' | Forge RPA';
      document.title = fullTitle;
      setOgTitle(fullTitle);
      if (ctx.description) setMetaDescription(ctx.description);

      var banner = document.getElementById('book-context-banner');
      var bannerBody = document.getElementById('book-context-banner-body');
      if (banner && bannerBody && ctx.banner) {
        bannerBody.textContent = ctx.banner;
        banner.classList.remove('hidden');
      }
    }
  })();
</script>

