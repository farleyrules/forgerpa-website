---
import PageLayout from '../layouts/PageLayout.astro';
import CTASection from '../components/CTASection.astro';
import {
  ALLOWED_ROLES,
  ALLOWED_CHALLENGES,
  ALLOWED_SYSTEMS,
  ALLOWED_TEAM_SIZES,
  ALLOWED_TIMELINES,
} from '../lib/qualifier-types.ts';


const defaultTitle = 'Book a Discovery Call';
const defaultDescription =
  'Schedule a 30-minute discovery call to discuss your finance and operational challenges. Proven in finance but applicable to other operational processes.';
const defaultHeroSubtitle =
  '30 minutes. No sales pitch. Just an honest conversation about where automation can make the biggest impact for your team.';
---

<PageLayout title={defaultTitle} description={defaultDescription} heroTitle={defaultTitle} heroSubtitle={defaultHeroSubtitle}>
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose max-w-none">
        <div id="book-context-banner" class="mb-10 hidden rounded-2xl border border-amber/40 bg-amber/10 px-5 py-4 text-sm text-charcoal">
          <p class="m-0 font-semibold">Context</p>
          <p id="book-context-banner-body" class="mt-2 mb-0 text-gray-800"></p>
          <p class="mt-3 mb-0 text-xs text-gray-600">
            Please mention this context when you book so we can prepare. If your scheduling tool asks how you heard about us,
            reference the page you came from.
          </p>
        </div>

        <div class="mb-12">
          <h2 class="text-3xl font-bold text-charcoal mb-6">What to Expect</h2>
          <p id="book-expect-lead" class="text-lg text-gray-700 leading-relaxed">
            During this 30-minute call, we will discuss your specific challenges in finance and operational processes. We will
            explore how our proprietary automation framework, proven in finance but applicable to other operational areas,
            might help reduce manual work and deliver measurable ROI for your team.
          </p>
          <p class="text-lg text-gray-700 leading-relaxed mt-4">
            Answer six short questions below so we can route your call to the right slot and come prepared.
          </p>
        </div>

        <!--
          "Before You Book" / Automation Readiness Checklist section removed.
          Rationale: the wizard's LOW-tier outcome screen already surfaces the
          checklist + /resources to "just researching" visitors at the moment
          of maximum relevance. Promoting it to ALL visitors at the top of
          /book competed with the wizard for attention. The checklist remains
          available at /resources and at /downloads/forge-rpa-readiness-checklist.html.
        -->

        <!-- ===================== Discovery Qualifier Wizard ===================== -->
        <div id="discovery-qualifier-wizard" class="mb-12 rounded-2xl border border-gray-200 bg-slate-light p-6 sm:p-8">

          <!-- ===================== Entry Fork =====================
               The initial view on page load. Lets the visitor choose how to
               start: a one-screen essentials form (recommended), straight to
               the calendar, or the full six-question wizard. qualifier-init.ts
               shows this by default and swaps in the chosen path. Every path
               keeps the existing submit / Turnstile / consent / Cal machinery;
               the fork only routes which path is visible. -->
          <div id="qualifier-entry-fork">
            <h2 class="text-2xl font-bold text-charcoal m-0 mb-2">How Would You Like to Start?</h2>
            <p class="text-sm text-gray-600 mb-6">Pick whatever fits. You can switch at any time.</p>
            <div class="grid gap-4 sm:grid-cols-3">
              <!-- Option 1: Essentials (recommended / primary) -->
              <button
                type="button"
                id="qualifier-fork-essentials"
                class="group relative flex flex-col rounded-xl border-2 border-amber bg-white p-5 text-left shadow-sm ring-1 ring-amber/30 transition-colors hover:border-amber/80 hover:bg-amber/5 focus:outline-none focus:ring-2 focus:ring-amber"
              >
                <span class="absolute right-3 top-3 rounded-full bg-amber px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-charcoal">Recommended</span>
                <span class="text-base font-bold text-charcoal">Just the Essentials</span>
                <span class="mt-2 text-sm text-gray-600">Four quick fields, then pick a time. The fastest way to get on the calendar.</span>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-amber-700 group-hover:text-amber-800">Start Here →</span>
              </button>
              <!-- Option 2: Straight to a Time -->
              <button
                type="button"
                id="qualifier-fork-straight"
                class="group flex flex-col rounded-xl border border-gray-300 bg-white p-5 text-left shadow-sm transition-colors hover:border-amber focus:outline-none focus:ring-2 focus:ring-amber"
              >
                <span class="text-base font-bold text-charcoal">Straight to a Time</span>
                <span class="mt-2 text-sm text-gray-600">Skip the questions and grab a slot now. We'll cover the details on the call.</span>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-gray-700 group-hover:text-charcoal">Pick a Time →</span>
              </button>
              <!-- Option 3: Tell Us More (full wizard) -->
              <button
                type="button"
                id="qualifier-fork-full"
                class="group flex flex-col rounded-xl border border-gray-300 bg-white p-5 text-left shadow-sm transition-colors hover:border-amber focus:outline-none focus:ring-2 focus:ring-amber"
              >
                <span class="text-base font-bold text-charcoal">Tell Us More</span>
                <span class="mt-2 text-sm text-gray-600">Answer six short questions so we route your call and come fully prepared.</span>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-gray-700 group-hover:text-charcoal">Answer Questions →</span>
              </button>
            </div>
          </div>
          <!-- ===================== End Entry Fork ===================== -->

          <!-- ===================== Essentials (one-screen) path =====================
               A single-screen form: Name, Work Email, Company, and a free-text
               "what would you like automated?". Reuses the SAME Turnstile mount
               pattern, the SAME clickwrap consent gate, the SAME validators, and
               POSTs to the SAME endpoint as the full wizard (qualifier-init.ts
               sends neutral allow-list-valid qualifier answers + the free text in
               additionalNotes). On success it reveals the Cal embed exactly like a
               full submit, gclid carried in the booking metadata. -->
          <div id="qualifier-essentials-path" class="hidden">
            <div class="mb-6 flex items-center justify-between">
              <h2 class="text-2xl font-bold text-charcoal m-0">Just the Essentials</h2>
              <button type="button" data-back-to-options class="text-sm text-gray-500 underline decoration-1 underline-offset-2 hover:text-charcoal">← Back to options</button>
            </div>
            <p class="text-sm text-gray-600 mb-6">Four quick fields and you're on the calendar. We keep everything confidential.</p>

            <div class="grid sm:grid-cols-2 gap-4">
              <label class="block">
                <span class="text-sm font-semibold text-charcoal">Name *</span>
                <input type="text" id="essentials-name" autocomplete="name" required class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-amber focus:ring-amber" />
              </label>
              <label class="block">
                <span class="text-sm font-semibold text-charcoal">Work email *</span>
                <input type="email" id="essentials-email" autocomplete="email" required class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-amber focus:ring-amber" />
                <p id="essentials-email-error" class="hidden mt-1 text-xs text-red-600"></p>
              </label>
              <label class="block sm:col-span-2">
                <span class="text-sm font-semibold text-charcoal">Company *</span>
                <input type="text" id="essentials-company" autocomplete="organization" required class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-amber focus:ring-amber" />
                <p id="essentials-company-error" class="hidden mt-1 text-xs text-red-600"></p>
              </label>
              <label class="block sm:col-span-2">
                <span class="text-sm font-semibold text-charcoal">What would you like automated? *</span>
                <textarea id="essentials-notes" rows="3" maxlength="1000" placeholder="A sentence or two about the manual work you'd most like to hand off. The more specific, the better we can prepare." class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-amber focus:ring-amber"></textarea>
                <p id="essentials-notes-error" class="hidden mt-1 text-xs text-red-600"></p>
              </label>
            </div>

            <div class="mt-6">
              <p class="text-sm font-semibold text-charcoal mb-2">Spam check</p>
              <div id="essentials-turnstile" class="cf-turnstile inline-block"></div>
            </div>

            <div class="mt-6">
              <label class="flex items-start gap-3 cursor-pointer">
                <input
                  type="checkbox"
                  id="essentials-consent"
                  class="mt-0.5 h-4 w-4 shrink-0 rounded border-gray-300 text-amber focus:ring-amber"
                />
                <span class="text-sm text-charcoal">
                  I have read and agree to the
                  <a
                    href="/terms"
                    target="_blank"
                    rel="noopener"
                    class="font-semibold text-amber-700 underline decoration-1 underline-offset-2 hover:text-amber-800"
                    >Terms &amp; Conditions</a>
                  and
                  <a
                    href="/privacy"
                    target="_blank"
                    rel="noopener"
                    class="font-semibold text-amber-700 underline decoration-1 underline-offset-2 hover:text-amber-800"
                    >Privacy Policy</a>.
                  <span class="mt-1 block text-xs text-gray-500">Terms &amp; Conditions v1, effective June 1, 2026 · Privacy Policy last updated June 1, 2026.</span>
                </span>
              </label>
              <p id="essentials-consent-error" class="hidden mt-2 text-xs text-red-600"></p>
            </div>

            <p id="essentials-error" class="hidden mt-4 text-sm text-red-600"></p>

            <div class="mt-6 flex justify-end">
              <button type="button" id="essentials-submit" class="inline-flex items-center gap-2 bg-amber text-charcoal font-bold px-6 py-2.5 rounded-lg hover:bg-amber/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                Submit and Book
              </button>
            </div>
          </div>
          <!-- ===================== End Essentials path ===================== -->

          <!-- ===================== Full 6-step wizard (path 3) =====================
               Unchanged behavior. Hidden until the visitor picks "Tell Us More"
               (or is restored mid-wizard from a prior session). The skip-to-time
               and "Back to options" controls live inside. -->
          <div id="qualifier-full-path" class="hidden">
          <div id="qualifier-full-path-back" class="mb-4">
            <button type="button" data-back-to-options class="text-sm text-gray-500 underline decoration-1 underline-offset-2 hover:text-charcoal">← Back to options</button>
          </div>
          <div id="qualifier-progress-container" class="mb-6">
            <div class="flex justify-between items-center mb-2">
              <h2 class="text-2xl font-bold text-charcoal m-0">Tell Us About Your Team</h2>
              <span id="qualifier-progress-label" class="text-xs font-semibold text-gray-600 uppercase tracking-wide">Step 1 of 6</span>
            </div>
            <div class="w-full h-2 bg-gray-200 rounded-full overflow-hidden">
              <div id="qualifier-progress-bar" class="h-full bg-amber transition-all duration-300" style="width: 17%"></div>
            </div>
          </div>

          <!-- ----- Step 1: Role ----- -->
          <div data-qualifier-step="1">
            <h3 class="text-xl font-semibold text-charcoal mb-4">What's your primary role?</h3>
            <div class="grid sm:grid-cols-2 gap-2">
              {ALLOWED_ROLES.map((role) => (
                <label class="flex items-center gap-3 rounded-lg border border-gray-300 bg-white px-4 py-3 cursor-pointer hover:border-amber transition-colors">
                  <input type="radio" name="qualifier-role" value={role} class="text-amber focus:ring-amber" />
                  <span class="text-sm text-charcoal">{role}</span>
                </label>
              ))}
            </div>
            <p id="qualifier-step1-error" class="hidden mt-3 text-sm text-red-600"></p>
            <div class="mt-6 flex justify-end">
              <button type="button" id="qualifier-step1-next" class="inline-flex items-center gap-2 bg-amber text-charcoal font-bold px-6 py-2.5 rounded-lg hover:bg-amber/90 transition-colors">
                Next →
              </button>
            </div>
          </div>

          <!-- ----- Step 2: Primary challenge ----- -->
          <div data-qualifier-step="2" class="hidden">
            <h3 class="text-xl font-semibold text-charcoal mb-4">What's your biggest current challenge?</h3>
            <div class="grid sm:grid-cols-2 gap-2">
              {ALLOWED_CHALLENGES.map((challenge) => (
                <label class="flex items-center gap-3 rounded-lg border border-gray-300 bg-white px-4 py-3 cursor-pointer hover:border-amber transition-colors">
                  <input type="radio" name="qualifier-challenge" value={challenge} class="text-amber focus:ring-amber" />
                  <span class="text-sm text-charcoal">{challenge}</span>
                </label>
              ))}
            </div>
            <p id="qualifier-step2-error" class="hidden mt-3 text-sm text-red-600"></p>
            <div class="mt-6 flex justify-between">
              <button type="button" id="qualifier-step2-back" class="text-sm text-gray-600 hover:text-charcoal">← Back</button>
              <button type="button" id="qualifier-step2-next" class="inline-flex items-center gap-2 bg-amber text-charcoal font-bold px-6 py-2.5 rounded-lg hover:bg-amber/90 transition-colors">
                Next →
              </button>
            </div>
          </div>

          <!-- ----- Step 3: Primary systems (multi-select) ----- -->
          <div data-qualifier-step="3" class="hidden">
            <h3 class="text-xl font-semibold text-charcoal mb-2">Which systems do you use?</h3>
            <p class="text-sm text-gray-600 mb-4">Pick all that apply — even Excel counts.</p>
            <div id="qualifier-systems-list" class="grid sm:grid-cols-2 gap-2">
              {ALLOWED_SYSTEMS.map((system) => (
                <label class="flex items-center gap-3 rounded-lg border border-gray-300 bg-white px-4 py-3 cursor-pointer hover:border-amber transition-colors">
                  <input type="checkbox" name="qualifier-systems" value={system} class="text-amber focus:ring-amber" />
                  <span class="text-sm text-charcoal">{system}</span>
                </label>
              ))}
            </div>
            <p id="qualifier-step3-error" class="hidden mt-3 text-sm text-red-600"></p>
            <div class="mt-6 flex justify-between">
              <button type="button" id="qualifier-step3-back" class="text-sm text-gray-600 hover:text-charcoal">← Back</button>
              <button type="button" id="qualifier-step3-next" class="inline-flex items-center gap-2 bg-amber text-charcoal font-bold px-6 py-2.5 rounded-lg hover:bg-amber/90 transition-colors">
                Next →
              </button>
            </div>
          </div>

          <!-- ----- Step 4: Team size ----- -->
          <div data-qualifier-step="4" class="hidden">
            <h3 class="text-xl font-semibold text-charcoal mb-4">How many people are affected by this workflow?</h3>
            <div class="grid sm:grid-cols-2 gap-2">
              {ALLOWED_TEAM_SIZES.map((size) => (
                <label class="flex items-center gap-3 rounded-lg border border-gray-300 bg-white px-4 py-3 cursor-pointer hover:border-amber transition-colors">
                  <input type="radio" name="qualifier-team-size" value={size} class="text-amber focus:ring-amber" />
                  <span class="text-sm text-charcoal">{size} people</span>
                </label>
              ))}
            </div>
            <p id="qualifier-step4-error" class="hidden mt-3 text-sm text-red-600"></p>
            <div class="mt-6 flex justify-between">
              <button type="button" id="qualifier-step4-back" class="text-sm text-gray-600 hover:text-charcoal">← Back</button>
              <button type="button" id="qualifier-step4-next" class="inline-flex items-center gap-2 bg-amber text-charcoal font-bold px-6 py-2.5 rounded-lg hover:bg-amber/90 transition-colors">
                Next →
              </button>
            </div>
          </div>

          <!-- ----- Step 5: Timeline ----- -->
          <div data-qualifier-step="5" class="hidden">
            <h3 class="text-xl font-semibold text-charcoal mb-4">When are you looking to act?</h3>
            <div class="grid sm:grid-cols-2 gap-2">
              {ALLOWED_TIMELINES.map((tl) => (
                <label class="flex items-center gap-3 rounded-lg border border-gray-300 bg-white px-4 py-3 cursor-pointer hover:border-amber transition-colors">
                  <input type="radio" name="qualifier-timeline" value={tl} class="text-amber focus:ring-amber" />
                  <span class="text-sm text-charcoal">{tl}</span>
                </label>
              ))}
            </div>
            <p id="qualifier-step5-error" class="hidden mt-3 text-sm text-red-600"></p>
            <div class="mt-6 flex justify-between">
              <button type="button" id="qualifier-step5-back" class="text-sm text-gray-600 hover:text-charcoal">← Back</button>
              <button type="button" id="qualifier-step5-next" class="inline-flex items-center gap-2 bg-amber text-charcoal font-bold px-6 py-2.5 rounded-lg hover:bg-amber/90 transition-colors">
                Next →
              </button>
            </div>
          </div>

          <!-- ----- Step 6: Contact + Turnstile ----- -->
          <div data-qualifier-step="6" class="hidden">
            <h3 class="text-xl font-semibold text-charcoal mb-2">A few last details</h3>
            <p class="text-sm text-gray-600 mb-6">So we can prepare and follow up. We keep everything confidential.</p>

            <div class="grid sm:grid-cols-2 gap-4">
              <label class="block">
                <span class="text-sm font-semibold text-charcoal">Name *</span>
                <input type="text" id="qualifier-contact-name" autocomplete="name" required class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-amber focus:ring-amber" />
              </label>
              <label class="block">
                <span class="text-sm font-semibold text-charcoal">Work email *</span>
                <input type="email" id="qualifier-contact-email" autocomplete="email" required class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-amber focus:ring-amber" />
                <p id="qualifier-step6-email-error" class="hidden mt-1 text-xs text-red-600"></p>
              </label>
              <label class="block">
                <span class="text-sm font-semibold text-charcoal">Company *</span>
                <input type="text" id="qualifier-contact-company" autocomplete="organization" required class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-amber focus:ring-amber" />
                <p id="qualifier-step6-company-error" class="hidden mt-1 text-xs text-red-600"></p>
              </label>
              <label class="block">
                <span class="text-sm font-semibold text-charcoal">Phone <span class="font-normal text-gray-500">(optional)</span></span>
                <input type="tel" id="qualifier-contact-phone" autocomplete="tel" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-amber focus:ring-amber" />
                <p id="qualifier-step6-phone-error" class="hidden mt-1 text-xs text-red-600"></p>
              </label>
              <label class="block sm:col-span-2">
                <span class="text-sm font-semibold text-charcoal">LinkedIn URL <span class="font-normal text-gray-500">(optional)</span></span>
                <input type="url" id="qualifier-contact-linkedinUrl" placeholder="https://www.linkedin.com/in/…" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-amber focus:ring-amber" />
              </label>
              <label class="block sm:col-span-2">
                <span class="text-sm font-semibold text-charcoal">What would you most like to focus on, or anything else we should know? <span class="font-normal text-gray-500">(optional)</span></span>
                <textarea id="qualifier-contact-additionalNotes" rows="3" maxlength="1000" placeholder="What you&rsquo;d most like to get out of the call, specific deadlines, systems context, or anything that helps us prepare." class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-amber focus:ring-amber"></textarea>
                <span class="mt-1 block text-xs text-gray-500">We&rsquo;ll have this ahead of the call. You won&rsquo;t need to re-enter anything when you pick a time.</span>
              </label>
            </div>

            <div class="mt-6">
              <p class="text-sm font-semibold text-charcoal mb-2">Spam check</p>
              <div id="qualifier-turnstile" class="cf-turnstile inline-block"></div>
            </div>

            <div class="mt-6">
              <label class="flex items-start gap-3 cursor-pointer">
                <input
                  type="checkbox"
                  id="qualifier-consent"
                  class="mt-0.5 h-4 w-4 shrink-0 rounded border-gray-300 text-amber focus:ring-amber"
                />
                <span class="text-sm text-charcoal">
                  I have read and agree to the
                  <a
                    href="/terms"
                    target="_blank"
                    rel="noopener"
                    class="font-semibold text-amber-700 underline decoration-1 underline-offset-2 hover:text-amber-800"
                    >Terms &amp; Conditions</a>
                  and
                  <a
                    href="/privacy"
                    target="_blank"
                    rel="noopener"
                    class="font-semibold text-amber-700 underline decoration-1 underline-offset-2 hover:text-amber-800"
                    >Privacy Policy</a>.
                  <span class="mt-1 block text-xs text-gray-500">Terms &amp; Conditions v1, effective June 1, 2026 · Privacy Policy last updated June 1, 2026.</span>
                </span>
              </label>
              <p id="qualifier-step6-consent-error" class="hidden mt-2 text-xs text-red-600"></p>
            </div>

            <p id="qualifier-step6-error" class="hidden mt-4 text-sm text-red-600"></p>

            <div class="mt-6 flex justify-between items-center">
              <button type="button" id="qualifier-step6-back" class="text-sm text-gray-600 hover:text-charcoal">← Back</button>
              <button type="button" id="qualifier-step6-submit" class="inline-flex items-center gap-2 bg-amber text-charcoal font-bold px-6 py-2.5 rounded-lg hover:bg-amber/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                Submit and Book
              </button>
            </div>
          </div>

          <!-- ----- Secondary skip-to-calendar link -----
               Shown only while the wizard is being answered (qualifier-init.ts
               hides it on any outcome). Deliberately a small, secondary text
               link, NOT a primary button: the wizard stays the default path.
               One click reveals the Cal.com calendar directly so a high-intent
               visitor can grab a time without answering the six questions. The
               gclid still rides into the booking metadata. -->
          <div id="qualifier-skip-to-calendar-row" class="mt-6 border-t border-gray-200 pt-4 text-center">
            <button type="button" id="qualifier-skip-to-calendar" class="text-sm text-gray-500 underline decoration-1 underline-offset-2 hover:text-charcoal">
              Short on time? Skip the questions and grab a time.
            </button>
          </div>

          </div>
          <!-- ===================== End Full 6-step wizard (path 3) ===================== -->

          <!-- Shared reveal targets. These live OUTSIDE the path wrappers so they are
               reachable from the essentials path, the straight-to-time path, AND
               the full wizard. showOutcome() un-hides the matching outcome block
               and (for HIGH/MEDIUM) reveals the Cal embed below. skipToCalendar()
               reveals #qualifier-skip-heading instead, then the same Cal embed. -->

          <!-- ----- Neutral heading shown above the calendar when the visitor
               skips the questions (no fit tier is computed for a skipper). -->
          <div id="qualifier-skip-heading" class="hidden">
            <h3 class="text-2xl font-bold text-charcoal mb-3">Pick a time below.</h3>
            <p class="text-gray-700 leading-relaxed">
              Grab whatever slot works. If you can, add a line about what you'd like to cover so we come prepared.
            </p>
          </div>

          <!-- ----- Outcome: HIGH ----- -->
          <div data-qualifier-outcome="HIGH" class="hidden">
            <h3 class="text-2xl font-bold text-charcoal mb-3">Great — let's book it.</h3>
            <p class="text-gray-700 leading-relaxed">
              Pick a time below. We'll come prepared with notes based on your answers.
            </p>
          </div>

          <!-- ----- Outcome: MEDIUM ----- -->
          <div data-qualifier-outcome="MEDIUM" class="hidden">
            <h3 class="text-2xl font-bold text-charcoal mb-3">Thanks — here's the calendar.</h3>
            <p class="text-gray-700 leading-relaxed">
              Pick a time below. We'll use your answers to make the conversation useful.
            </p>
          </div>

          <!-- ----- Outcome: LOW ----- -->
          <div data-qualifier-outcome="LOW" class="hidden">
            <h3 class="text-2xl font-bold text-charcoal mb-3">Thanks for the context.</h3>
            <p class="text-gray-700 leading-relaxed mb-4">
              Based on where you are today, the most useful starting point is probably our
              <a href="/downloads/forge-rpa-readiness-checklist.html" class="underline text-amber-700 hover:text-amber-800" target="_blank" rel="noopener noreferrer">Automation Readiness Checklist</a>
              and our published <a href="/resources" class="underline text-amber-700 hover:text-amber-800">case studies and resources</a>. They'll help you scope what's worth automating before we talk.
            </p>
