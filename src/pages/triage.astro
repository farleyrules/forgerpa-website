---
import PageLayout from '../layouts/PageLayout.astro';

const title = 'Book a free 15-minute triage call | Forge RPA';
const description =
  'Tell us what is eating your team’s time and we will tell you straight whether it is worth automating. Free 15-minute triage call. No pitch.';
const heroTitle = 'Book a free 15-minute triage call';
const heroSubtitle =
  'Tell us what is eating your team’s time and we will tell you straight whether it is worth automating. No pitch.';
---

<PageLayout
  title={title}
  description={description}
  heroTitle={heroTitle}
  heroSubtitle={heroSubtitle}
>
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">

      <div id="triage-form-root">
        <!-- Single-screen form card -->
        <div id="triage-form-card" class="rounded-2xl border border-gray-200 bg-slate-light p-6 sm:p-8">
          <h2 class="text-2xl font-bold text-charcoal mb-2">A couple of quick details</h2>
          <p class="text-sm text-gray-600 mb-6">
            Two fields and you can pick a time. The call is 15 minutes, free, and there is no sales pitch. We just tell you straight whether it is worth automating.
          </p>

          <div class="grid gap-4">
            <label class="block">
              <span class="text-sm font-semibold text-charcoal">First name *</span>
              <input
                type="text"
                id="triage-name"
                autocomplete="given-name"
                required
                class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-amber focus:ring-amber"
              />
              <p id="triage-name-error" class="hidden mt-1 text-xs text-red-600"></p>
            </label>

            <label class="block">
              <span class="text-sm font-semibold text-charcoal">Email *</span>
              <input
                type="email"
                id="triage-email"
                autocomplete="email"
                required
                class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-amber focus:ring-amber"
              />
              <p id="triage-email-error" class="hidden mt-1 text-xs text-red-600"></p>
            </label>

            <label class="block">
              <span class="text-sm font-semibold text-charcoal">
                In a sentence, what would you like to fix or automate?
                <span class="font-normal text-gray-500">(optional)</span>
              </span>
              <textarea
                id="triage-focus"
                rows="3"
                maxlength="1000"
                placeholder="A monthly report, a fragile workbook, a Power Query refresh, data cleanup, a process that should run itself..."
                class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-amber focus:ring-amber"
              ></textarea>
            </label>
          </div>

          <!-- Spam check (Cloudflare Turnstile, site key fetched at runtime) -->
          <div class="mt-6">
            <p class="text-sm font-semibold text-charcoal mb-2">Spam check</p>
            <div id="triage-turnstile" class="cf-turnstile inline-block"></div>
          </div>

          <!-- Clickwrap consent (same pattern + versions as /book) -->
          <div class="mt-6">
            <label class="flex items-start gap-3 cursor-pointer">
              <input
                type="checkbox"
                id="triage-consent"
                class="mt-0.5 h-4 w-4 shrink-0 rounded border-gray-300 text-amber focus:ring-amber"
              />
              <span class="text-sm text-charcoal">
                I have read and agree to the
                <a
                  href="/terms"
                  target="_blank"
                  rel="noopener"
                  class="font-semibold text-amber-700 underline decoration-1 underline-offset-2 hover:text-amber-800"
                  >Terms &amp; Conditions</a>
                and
                <a
                  href="/privacy"
                  target="_blank"
                  rel="noopener"
                  class="font-semibold text-amber-700 underline decoration-1 underline-offset-2 hover:text-amber-800"
                  >Privacy Policy</a>.
                <span class="mt-1 block text-xs text-gray-500">Terms &amp; Conditions v1, effective June 1, 2026 · Privacy Policy last updated June 1, 2026.</span>
              </span>
            </label>
            <p id="triage-consent-error" class="hidden mt-2 text-xs text-red-600"></p>
          </div>

          <p id="triage-form-error" class="hidden mt-4 text-sm text-red-600"></p>

          <div class="mt-6">
            <button
              type="button"
              id="triage-submit"
              class="inline-flex items-center gap-2 bg-amber text-charcoal font-bold px-6 py-2.5 rounded-lg hover:bg-amber/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Book my 15-minute call
            </button>
          </div>
        </div>

        <!-- Success header (revealed after a valid submit) -->
        <div id="triage-success" class="hidden">
          <h2 class="text-2xl font-bold text-charcoal mb-3">Great. Pick a time below.</h2>
          <p class="text-gray-700 leading-relaxed">
            Choose a slot for your free 15-minute triage call. We will come ready to give you a straight read on what is worth automating.
          </p>
        </div>
      </div>

      <!-- Cal.com inline embed (15-min Triage event) - hidden until a valid
           submit. Name + email are prefilled via the embed config.
           TODO: David creates a 15-min Triage event in Cal.com and sets PUBLIC_CALCOM_TRIAGE_URL -->
      <div id="triage-cal-container" class="mt-6 hidden">
        <div id="triage-cal-inline" style="min-width:320px;width:100%"></div>
      </div>

      <div class="text-center mt-10 text-sm text-gray-500">
        15 minutes. Free. No pitch. We respect your time and will come prepared.
      </div>
    </div>
  </section>
</PageLayout>

<!-- Triage logic - Astro/Vite bundles this TypeScript module. -->
<script>
  import '../lib/triage-init.ts';
</script>
