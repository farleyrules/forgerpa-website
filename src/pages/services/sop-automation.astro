---
import PageLayout from '../../layouts/PageLayout.astro';
import CTASection from '../../components/CTASection.astro';

// Service schema for SEO. Rendered in body; Google reads JSON-LD anywhere in the document.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Finance and Operations Process Automation',
  serviceType: 'SOP and Process Automation',
  description:
    'We turn documented finance and operations SOPs into reliable, maintainable automation using advanced Excel, VBA, Power Query, and targeted RPA. Month-end close, accounts payable, reconciliations, reporting, and governed operational handoffs, with testing, error handling, and runbooks.',
  provider: {
    '@type': 'Organization',
    name: 'Forge RPA LLC',
    url: 'https://forgerpa.com',
  },
  areaServed: {
    '@type': 'Country',
    name: 'United States',
  },
  url: 'https://forgerpa.com/services/sop-automation',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What kinds of processes do you automate?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We focus on finance and accounting processes and the operational handoffs that feed them: month-end close, accounts payable, reconciliations, financial reporting, and governed operational workflows. If a process is documented, repeatable, and currently done by hand across spreadsheets and systems, it is a candidate.',
      },
    },
    {
      '@type': 'Question',
      name: 'What technology do you build the automation with?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We match the tool to the step rather than forcing one platform on everything. That usually means advanced Excel, VBA, and Power Query, with targeted RPA bots where a process has to drive an application that has no API. The goal is the right tool for each step: no over-engineering, no under-engineering, and nothing your team cannot maintain.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long does a build take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most builds deliver working automation in 3 to 7 weeks, which is significantly faster than a traditional consulting engagement. We still hold high standards for testing, error handling, and documentation; the speed comes from a disciplined parse-classify-recommend-generate-review-deploy method, not from cutting corners.',
      },
    },
    {
      '@type': 'Question',
      name: 'What do you hand over at the end?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You receive a process analysis report, a technology recommendation per step, production-ready automation code with error handling and logging, an automated test suite covering every path and exception, and an operations runbook so your team can maintain and extend the automation. You own everything we build.',
      },
    },
    {
      '@type': 'Question',
      name: 'Will this replace my people?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. The work we automate is data movement, not analysis: manual entry across systems, spreadsheet rebuilds that should have been a query, exception routing that means checking three screens. Automating that gives your senior team back the capacity for variance analysis, FP&A support, and decision support, the work they were hired for. We replace the manual work that keeps people from being the analysts you hired.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you need a fully written SOP before you can start?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A documented SOP helps, but a clear process outline is enough to begin. Part of the early work is parsing what you have into every step, decision point, system interaction, and exception path. Where documentation is thin, we capture the process on the discovery call and in early sessions before any code is written.',
      },
    },
  ],
};
---

<PageLayout
  title="Finance and Operations Process Automation"
  description="Advanced Excel, VBA, Power Query, and RPA automation for finance, accounting, and adjacent operations processes. Month-end close, AP, reconciliations, reporting, and governed operational handoffs."
  heroTitle="Finance and Operations Process Automation"
  heroSubtitle="We turn your documented finance and operations processes into reliable, maintainable automation using advanced Excel, VBA, Power Query, and targeted RPA tools."
  heroCta="See How We Can Help"
  heroCtaLink="/book?from=sop"
>
  <!-- JSON-LD structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="py-20 lg:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- What We Do -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">What We Do</h2>
        <p class="text-lg text-gray-700 leading-relaxed">
          We specialize in finance and accounting processes, and the operational handoffs that feed them. Whether it's month-end close, accounts payable, reconciliations, financial reporting, or governed operational workflows, we transform complex manual procedures into reliable automated solutions using advanced Excel, VBA, Power Query, and targeted RPA tools when appropriate.
        </p>
        <p class="mt-4 text-lg text-gray-700 leading-relaxed">
          Our approach typically delivers working automation in 3-7 weeks, significantly faster than traditional consulting engagements while maintaining high standards for testing, error handling, and documentation.
        </p>
      </div>

      <!-- Where the recovered capacity goes -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">Where the recovered capacity goes</h2>
        <p class="text-lg text-gray-700 leading-relaxed">
          The work being automated is not analysis. It is data movement. Manual data entry across systems. Spreadsheet rebuilds that should have been a query. Exception routing that requires looking at three screens. Audit-evidence packaging that's 80% lookup and 20% judgment.
        </p>
        <p class="mt-4 text-lg text-gray-700 leading-relaxed">
          Automating the data movement gives your senior team back the capacity to do the work they were hired for: variance analysis, FP&amp;A support, vendor relationship management, system improvements, decision support for leadership. The recovered hours don't go away. They get redeployed to the work that compounds.
        </p>
        <p class="mt-4 text-lg text-gray-700 leading-relaxed">
          This is the answer to the unstated question every finance and operations leader asks before approving automation work: <strong class="text-charcoal">what happens to my people?</strong> Forge RPA does not replace people. We replace the manual work that prevents them from being the analysts and operators you hired.
        </p>
        <p class="mt-4 text-lg text-gray-700 leading-relaxed">
          Roles built around manual data movement also tend to run higher turnover than analytical roles. At a fully-loaded turnover cost of $15,000 to $50,000 per event, even a modest reduction in attrition adds meaningfully to ROI. Automation does not eliminate jobs; it eliminates the friction that drives people out of them.
        </p>
      </div>

      <!-- Deliverables -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">What You Receive</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {[
            { title: 'Process Analysis Report', desc: 'Every step classified by automation potential, technology fit, and complexity.' },
            { title: 'Technology Recommendation', desc: 'The right tool for each step, matched to your systems, budget, and maintainability requirements.' },
            { title: 'Working Automation Code', desc: 'Production-ready code with error handling, logging, and monitoring.' },
            { title: 'Test Suite', desc: 'Automated tests validating every process path and exception scenario.' },
            { title: 'Operations Runbook', desc: 'Complete documentation for your team to maintain and extend the automation.' },
          ].map((item) => (
            <div class="bg-slate-light rounded-xl p-6">
              <h3 class="font-bold text-charcoal mb-2">{item.title}</h3>
              <p class="text-gray-600 text-sm">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- How It Works -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">How It Works</h2>
        <div class="space-y-8">
          {[
            { step: 'Parse', desc: 'AI ingests your SOP and extracts every step, decision point, system interaction, and exception path.' },
            { step: 'Classify', desc: 'Each step is scored for automation potential using our six-criterion framework.' },
            { step: 'Recommend', desc: 'Technology matching ensures the right tool for each step, no over-engineering, no under-engineering.' },
            { step: 'Generate', desc: 'AI produces a code scaffold with page objects, data models, and orchestration logic.' },
            { step: 'Review', desc: 'Engineers refine the scaffold, add error handling, and build comprehensive test suites.' },
            { step: 'Deploy', desc: 'Production deployment with monitoring, alerting, and hypercare support.' },
          ].map((item, i) => (
            <div class="flex items-start gap-6">
              <div class="w-12 h-12 bg-amber rounded-full flex items-center justify-center flex-shrink-0">
                <span class="text-charcoal font-bold">{i + 1}</span>
              </div>
              <div>
                <h3 class="text-xl font-bold text-charcoal">{item.step}</h3>
                <p class="text-gray-600 mt-1">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <CTASection
    heading="Which Processes Should You Automate First?"
    subtext="Book a 30-minute call to walk through your top one to three SOPs or process outlines. We will outline how we score automation potential, what a build typically looks like, and what good documentation includes before development."
    ctaText="See How We Can Help"
    ctaLink="/book?from=sop"
  />
</PageLayout>
