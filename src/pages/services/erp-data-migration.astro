---
import PageLayout from '../../layouts/PageLayout.astro';
import CTASection from '../../components/CTASection.astro';

// Service schema for SEO. Rendered in body; Google reads JSON-LD anywhere in the document.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Workday & ERP Data Migration',
  serviceType: 'ERP and Workday Data Migration',
  description:
    'Template-driven ERP and Workday data migration with reconciliation-verified accuracy. 31 pre-built Workday iLoad templates and mappings for SAP, Oracle, PeopleSoft, NetSuite, and legacy systems. Verified from both the technical and accounting perspective.',
  provider: {
    '@type': 'Organization',
    name: 'Forge RPA LLC',
    url: 'https://forgerpa.com',
  },
  areaServed: {
    '@type': 'Country',
    name: 'United States',
  },
  url: 'https://forgerpa.com/services/erp-data-migration',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What source systems can you migrate from?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We migrate from SAP, Oracle, PeopleSoft, ADP, Kronos, NetSuite, QuickBooks, and custom or legacy systems. The mapping methodology works from virtually any source platform, so if your system is not on that list we scope it during the discovery call.',
      },
    },
    {
      '@type': 'Question',
      name: 'What makes your Workday migration different?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Workday conversion is our deepest specialty. We use 31 pre-built iLoad templates validated across multiple implementations, spanning 8 source systems and 7 Workday modules. Each template handles field mapping, data transformation, validation rules, and error reporting, so your data lands in Workday clean, complete, and audit-ready instead of being hand-built from scratch every time.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do you make sure the converted data is accurate?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Every conversion is reconciliation-verified. We follow a disciplined extract, transform, validate, reconcile approach and check the result from both the technical and the accounting perspective. We verify opening balances, sub-ledger ties, and control totals so your auditors do not find surprises in the converted data.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you only migrate to Workday?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. The same methodology works for any ERP transition. Whether the target is Workday, NetSuite, SAP, or another platform, we handle system consolidation after acquisitions, legacy-system retirement, on-premise to cloud moves, and master-data cleanup and enrichment as part of the conversion.',
      },
    },
    {
      '@type': 'Question',
      name: 'Why use a finance-led team for data migration?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most data conversion specialists are technicians who can map fields and transform formats but cannot tell you when a journal-entry mapping will create a downstream audit issue or when a cost-center structure will break your reporting hierarchy. Our team brings decades of hands-on experience running ERP financials in production, so we catch the accounting problems a pure-technical team would miss.',
      },
    },
    {
      '@type': 'Question',
      name: 'How is a migration project priced?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We scope each migration as a fixed-fee project after reviewing your source and target systems, data volume, and cutover constraints, so you know the full price before we start. Change orders and ongoing support beyond the defined scope are billed hourly and disclosed up front.',
      },
    },
  ],
};
---

<PageLayout
  title="Workday & ERP Data Migration: 31 iLoad Templates"
  description="Template-driven data migration for Workday, NetSuite, SAP, and more. 31 pre-built Workday iLoad templates, 8 source system mappings, and reconciliation-verified accuracy."
  heroTitle="ERP Data Migration Done Right and Done Fast"
  heroSubtitle="Template-driven data conversion with reconciliation-verified accuracy. Whether you are migrating to Workday, consolidating ERP systems, or moving off legacy platforms, we get your data there clean."
  heroCta="Discuss Your Migration"
  heroCtaLink="/contact?from=migration"
>
  <!-- JSON-LD structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="py-20 lg:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- The Problem -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">The Problem</h2>
        <p class="text-lg text-gray-700 leading-relaxed">
          ERP implementations fail at data conversion more than any other phase. Legacy system data does not map cleanly to your target system's data model. Field formats differ. Business rules conflict. And every error that makes it into production creates downstream problems that compound across modules.
        </p>
        <p class="mt-4 text-lg text-gray-700 leading-relaxed">
          Most implementation partners treat data conversion as a secondary workstream. We treat it as the foundation. Because when your data is wrong, everything built on top of it is wrong too.
        </p>
      </div>

      <!-- Workday Specialty -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">Workday Migration Specialty</h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-8">
          Our deepest expertise is in Workday conversions. Our conversion engine uses pre-built iLoad templates that have been validated across multiple implementations. Every template handles field mapping, data transformation, validation rules, and error reporting, so your data arrives in Workday clean, complete, and audit-ready.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
          <div class="bg-charcoal rounded-xl p-6 text-center">
            <div class="text-4xl font-extrabold text-amber">31</div>
            <div class="text-gray-400 mt-2">Workday iLoad Templates</div>
          </div>
          <div class="bg-charcoal rounded-xl p-6 text-center">
            <div class="text-4xl font-extrabold text-amber">8</div>
            <div class="text-gray-400 mt-2">Source Systems</div>
          </div>
          <div class="bg-charcoal rounded-xl p-6 text-center">
            <div class="text-4xl font-extrabold text-amber">7</div>
            <div class="text-gray-400 mt-2">Workday Modules</div>
          </div>
        </div>
      </div>

      <!-- Source Systems -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">Supported Source Systems</h2>
        <div class="flex flex-wrap gap-3">
          {['SAP', 'Oracle', 'PeopleSoft', 'ADP', 'Kronos', 'NetSuite', 'QuickBooks', 'Custom/Legacy'].map((system) => (
            <span class="px-4 py-2 bg-amber/10 text-amber-dark font-medium rounded-lg text-sm">
              {system}
            </span>
          ))}
        </div>
        <p class="mt-4 text-gray-600 text-sm">
          Don't see your system listed? We can map and convert from virtually any source platform. <a href="/contact?from=migration" class="text-amber-dark hover:underline">Book a discovery call</a> to discuss your specific environment.
        </p>
      </div>

      <!-- Beyond Workday -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">Beyond Workday</h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-8">
          Our migration methodology works for any ERP transition. The same disciplined approach, extract, transform, validate, reconcile, applies whether your target is Workday, NetSuite, SAP, or another platform.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {[
            { title: 'System Consolidation', desc: 'Merging multiple ERPs into a single platform after acquisitions or organizational restructuring.' },
            { title: 'Legacy System Migration', desc: 'Moving off end-of-life systems with full data preservation, audit trail integrity, and zero business disruption.' },
            { title: 'Cloud Migration', desc: 'On-premise to cloud transitions with data validation at every stage and parallel testing before cutover.' },
            { title: 'Data Cleanup and Enrichment', desc: 'Standardizing, deduplicating, and enriching master data as part of the migration process.' },
          ].map((item) => (
            <div class="bg-slate-light rounded-xl p-6">
              <h3 class="font-bold text-charcoal mb-2">{item.title}</h3>
              <p class="text-gray-600 text-sm">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Finance Expertise Differentiator -->
      <div class="mb-16 bg-gradient-to-br from-charcoal to-charcoal-light rounded-xl p-8 lg:p-12">
        <h2 class="text-2xl font-bold text-amber mb-4">The Finance Expertise Advantage</h2>
        <p class="text-gray-300 leading-relaxed">
          Most data conversion specialists are technicians. They can map fields and transform formats. But they cannot tell you when a journal entry mapping will create a downstream audit issue, or when a cost center structure will break your financial reporting hierarchy.
        </p>
        <p class="text-gray-300 leading-relaxed mt-4">
          Our team brings decades of hands-on experience managing ERP financials in production. We verify every conversion from both the technical and accounting perspective. Your auditors will not find surprises in your converted data.
        </p>
      </div>

    </div>
  </section>

  <CTASection
    heading="Get Your Data Right the First Time"
    subtext="Book a 30-minute call to review source and target systems, cutover constraints, and how template-driven conversion plus reconciliation fits your timeline."
    ctaText="Discuss Your Migration"
    ctaLink="/contact?from=migration"
  />
</PageLayout>
