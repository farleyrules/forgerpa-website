---
import PageLayout from '../../layouts/PageLayout.astro';
import CTASection from '../../components/CTASection.astro';

// Service schema for SEO. Rendered in body; Google reads JSON-LD anywhere in the document.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Process Mining for Finance & Operations',
  serviceType: 'Process Mining and Discovery',
  description:
    'Data-driven process discovery for finance, accounting, and operations. We reconstruct how processes actually execute from ERP and event-log data, identify bottlenecks and rework loops, and score each segment for automation potential with ROI projections.',
  provider: {
    '@type': 'Organization',
    name: 'Forge RPA LLC',
    url: 'https://forgerpa.com',
  },
  areaServed: {
    '@type': 'Country',
    name: 'United States',
  },
  url: 'https://forgerpa.com/services/process-mining',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is process mining?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Process mining uses event-log data from your ERP, accounting, and adjacent operational systems to reconstruct how a process actually executes. Every transaction, handoff, and delay is captured and visualized, giving you an objective, data-driven view of your finance and operations reality instead of a process map drawn from interviews and assumptions.',
      },
    },
    {
      '@type': 'Question',
      name: 'How is process mining different from a traditional process review?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A traditional review relies on interviews and documented procedures, which capture how people believe the process works. Process mining reads the actual event data, so it surfaces the hidden bottlenecks, manual workarounds, and rework loops that interviews miss. No assumptions, just the trail every transaction leaves behind.',
      },
    },
    {
      '@type': 'Question',
      name: 'What data do you need from us?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We need event logs or timestamped transaction records from your ERP, workflow systems, and relevant databases. Most systems already capture this. On the discovery call we confirm what is available and how to extract it, and we work with your team to pull the logs without disrupting operations.',
      },
    },
    {
      '@type': 'Question',
      name: 'What do you typically find?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Common findings include hidden rework loops where a meaningful share of transactions cycle through the same steps more than once, approval bottlenecks where one person becomes a single point of delay, undocumented workarounds that staff use to get the job done, and high-volume rule-based segments that are strong candidates for immediate automation.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does process mining connect to automation?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Every process segment we discover is scored for automation potential using our six-criterion framework, with ROI projections. The output is not just a diagnosis of where the friction lives; it is a ranked, defensible view of which segments to automate first, which feeds directly into an automation roadmap.',
      },
    },
    {
      '@type': 'Question',
      name: 'How is process mining priced?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We scope process mining as a fixed-fee engagement after the discovery call, sized to the number of processes and systems in view, so you know the price before we start. Any follow-on build work or advisory time beyond the defined scope is billed hourly and disclosed up front.',
      },
    },
  ],
};
---

<PageLayout
  title="Process Mining for Finance & Operations"
  description="Data-driven process discovery for finance and operations. Identify bottlenecks and automation opportunities using actual transaction and event data."
  heroTitle="Process Mining for Finance and Operations"
  heroSubtitle="Process mining reveals how your finance, accounting, and operations processes actually work. We analyze real transaction and event data from your systems to identify bottlenecks, exceptions, and high-value automation opportunities."
  heroCta="Discuss Process Mining"
  heroCtaLink="/contact?from=process-mining"
>
  <!-- JSON-LD structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="py-20 lg:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- What It Is -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">What It Is</h2>
        <p class="text-lg text-gray-700 leading-relaxed">
          Process mining uses event log data from your ERP, accounting, and adjacent operational systems to reconstruct how processes actually execute. Every transaction, every handoff, and every delay is captured and visualized. The result is an objective, data-driven view of your finance and operations reality.
        </p>
        <p class="mt-4 text-lg text-gray-700 leading-relaxed">
          This approach reveals hidden bottlenecks, manual workarounds, and high-value automation opportunities that traditional process reviews often miss.
        </p>
      </div>

      <!-- How It Works -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">How It Works</h2>
        <div class="space-y-8">
          {[
            { stage: 'Data Extraction', desc: 'We extract event logs from your ERP, workflow systems, and databases. Every transaction creates a trail, we follow it.' },
            { stage: 'Process Discovery', desc: 'Algorithms reconstruct the actual process flow from event data. No interviews needed. No assumptions. Just data.' },
            { stage: 'Conformance Checking', desc: 'We compare the discovered process against your documented SOPs to identify deviations, workarounds, and undocumented steps.' },
            { stage: 'Bottleneck Analysis', desc: 'Statistical analysis identifies where delays accumulate, which handoffs create friction, and which steps generate rework.' },
            { stage: 'Automation Opportunity Mapping', desc: 'Every process segment is scored for automation potential using our six-criterion framework, with ROI projections.' },
          ].map((item, i) => (
            <div class="flex items-start gap-6">
              <div class="w-12 h-12 bg-amber rounded-full flex items-center justify-center flex-shrink-0">
                <span class="text-charcoal font-bold">{i + 1}</span>
              </div>
              <div>
                <h3 class="text-xl font-bold text-charcoal">{item.stage}</h3>
                <p class="text-gray-600 mt-1">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Sample Findings -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">What We Typically Find</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {[
            { finding: 'Hidden Rework Loops', detail: '15-30% of transactions cycle through the same steps multiple times.' },
            { finding: 'Approval Bottlenecks', detail: 'One manager becomes a single point of delay for dozens of processes.' },
            { finding: 'Undocumented Workarounds', detail: 'Staff bypass official procedures, sometimes for good reasons that should be formalized.' },
            { finding: 'Automation Sweet Spots', detail: 'High-volume, rule-based segments that are perfect for immediate automation.' },
          ].map((item) => (
            <div class="bg-charcoal rounded-xl p-6">
              <h3 class="font-bold text-amber mb-2">{item.finding}</h3>
              <p class="text-gray-400 text-sm">{item.detail}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <CTASection
    heading="Stop Guessing Where the Bottlenecks Are"
    subtext="Book a 30-minute call to review event data readiness, what mining can answer for your finance or operations processes, and how findings connect to an automation roadmap."
    ctaText="Discuss Process Mining"
    ctaLink="/contact?from=process-mining"
  />
</PageLayout>
