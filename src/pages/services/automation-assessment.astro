---
import PageLayout from '../../layouts/PageLayout.astro';
import CTASection from '../../components/CTASection.astro';

// Service schema for SEO. Rendered in body; Google reads JSON-LD anywhere in the document.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Automation Assessment for Finance & Operations Teams',
  serviceType: 'Automation Assessment',
  description:
    'A data-driven automation assessment that scores finance and operations processes against a six-criterion framework, projects ROI, and delivers a prioritized implementation roadmap with technology recommendations, so you invest in the right automations from day one.',
  provider: {
    '@type': 'Organization',
    name: 'Forge RPA LLC',
    url: 'https://forgerpa.com',
  },
  areaServed: {
    '@type': 'Country',
    name: 'United States',
  },
  url: 'https://forgerpa.com/services/automation-assessment',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is an automation assessment?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'An automation assessment is a short diagnostic that inventories your finance and operations processes, scores each one for automation potential against a six-criterion framework, projects ROI, and hands you a prioritized roadmap. The point is to know exactly what to automate first, and in what order, before you spend a dollar on a build.',
      },
    },
    {
      '@type': 'Question',
      name: 'What do I receive at the end of the assessment?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Five deliverables: a process inventory with time and system estimates, an automation score for each process across six criteria, conservative-to-aggressive ROI projections with payback periods, a technology recommendation matched to each process, and a sequenced implementation roadmap with budget and dependency mapping. Your finance leadership can act on it with or without us.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long does the assessment take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The core assessment runs in 2 to 3 business days. Day one is discovery through stakeholder interviews, process observation, SOP review, and a system inventory. Day two is scoring, ROI modeling, and technology matching. Day three is the executive presentation, the detailed report, and the roadmap with Q&A.',
      },
    },
    {
      '@type': 'Question',
      name: 'What are the six scoring criteria?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Each process is scored on rule complexity, transaction volume, data structure, process stability, error impact, and technology compatibility. Together those produce a weighted score that predicts how successfully a process can be automated and which tool fits it best, from native Microsoft 365 capabilities to targeted RPA and ERP automation.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do we need to involve IT?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Not for the diagnostic itself. The assessment is owned by finance and operations. IT involvement starts later, at implementation, once you have decided which automations to build.',
      },
    },
    {
      '@type': 'Question',
      name: 'How is this priced, and does the fee credit toward a build?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The assessment is a fixed fee scoped to your environment after the discovery call, so you know the full price before we start. If you move forward with an automation build with us, the assessment fee is credited toward that work. Any change orders or advisory time beyond the defined scope are billed hourly and disclosed up front.',
      },
    },
  ],
};
---

<PageLayout
  title="Automation Assessment for Finance & Ops Teams"
  description="Data-driven process scoring, ROI projections, and prioritized automation roadmaps. Delivered in 2-3 days."
  heroTitle="Know Exactly What to Automate First"
  heroSubtitle="A data-driven assessment that scores finance and operations processes for automation potential, projects ROI, and delivers a prioritized roadmap, so you invest in the right automations from day one."
  heroCta="Book a Discovery Call"
  heroCtaLink="/book"
>
  <!-- JSON-LD structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="py-20 lg:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- What It Is -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">What It Is</h2>
        <p class="text-lg text-gray-700 leading-relaxed">
          Our Automation Assessment evaluates your finance and accounting processes using a six-criterion scoring framework developed across numerous finance transformations. Every process receives a weighted score that predicts automation success, estimated ROI, and recommended technology approach.
        </p>
        <p class="mt-4 text-lg text-gray-700 leading-relaxed">
          This is the same framework we have used at Fortune 500 manufacturers to prioritize automations across departments. It removes guesswork and ensures your automation investment delivers the fastest possible return. This helps determine how well each process can be automated using the right combination of tools for your environment, from Microsoft 365 capabilities to targeted RPA and ERP automation.
        </p>
      </div>

      <!-- What You Receive -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">What You Receive</h2>
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-amber/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-amber-dark font-bold">1</span>
            </div>
            <div>
              <h3 class="font-bold text-charcoal">Process Inventory</h3>
              <p class="text-gray-600 mt-1">Complete catalog of processes with time estimates, systems involved, and current pain points.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-amber/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-amber-dark font-bold">2</span>
            </div>
            <div>
              <h3 class="font-bold text-charcoal">Automation Scoring</h3>
              <p class="text-gray-600 mt-1">Each process scored on rule complexity, volume, data structure, stability, error impact, and technology compatibility.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-amber/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-amber-dark font-bold">3</span>
            </div>
            <div>
              <h3 class="font-bold text-charcoal">ROI Projections</h3>
              <p class="text-gray-600 mt-1">Conservative, moderate, and aggressive ROI scenarios with payback period estimates for each candidate.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-amber/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-amber-dark font-bold">4</span>
            </div>
            <div>
              <h3 class="font-bold text-charcoal">Technology Recommendations</h3>
              <p class="text-gray-600 mt-1">The optimal automation technology matched to each process based on technical requirements, cost, and maintainability.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-amber/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-amber-dark font-bold">5</span>
            </div>
            <div>
              <h3 class="font-bold text-charcoal">Implementation Roadmap</h3>
              <p class="text-gray-600 mt-1">Prioritized sequence of automations with timeline, budget estimates, and dependency mapping.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- How It Works -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">How It Works</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-slate-light rounded-xl p-8 text-center">
            <div class="text-3xl font-extrabold text-amber mb-2">Day 1</div>
            <h3 class="font-bold text-charcoal mb-2">Discovery</h3>
            <p class="text-gray-600 text-sm">Stakeholder interviews, process observation, SOP review, and system inventory.</p>
          </div>
          <div class="bg-slate-light rounded-xl p-8 text-center">
            <div class="text-3xl font-extrabold text-amber mb-2">Day 2</div>
            <h3 class="font-bold text-charcoal mb-2">Analysis</h3>
            <p class="text-gray-600 text-sm">AI-powered process scoring, ROI modeling, technology matching, and roadmap development.</p>
          </div>
          <div class="bg-slate-light rounded-xl p-8 text-center">
            <div class="text-3xl font-extrabold text-amber mb-2">Day 3</div>
            <h3 class="font-bold text-charcoal mb-2">Delivery</h3>
            <p class="text-gray-600 text-sm">Executive presentation, detailed report, and implementation roadmap with Q&A.</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <CTASection
    heading="Stop Guessing. Start Measuring."
    subtext="Book a 30-minute consultation to confirm fit, scope, and timing for a formal Automation Assessment. Same calendar as our discovery calls, with the conversation centered on scoring, ROI, and roadmap work."
    ctaText="Book Your Assessment Consultation"
    ctaLink="/book?from=assessment"
  />
</PageLayout>
