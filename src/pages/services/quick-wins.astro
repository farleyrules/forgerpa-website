---
import PageLayout from '../../layouts/PageLayout.astro';
import CTASection from '../../components/CTASection.astro';
import InlineCta from '../../components/InlineCta.astro';

const faqs = [
  {
    q: "What's a Spreadsheet Rescue versus an Automation Assessment?",
    a: "A spreadsheet rescue is a fast, fixed-price fix or rebuild of one workbook with a single defined outcome: it's broken, it's slow, or it's fragile and you need it dependable. When the job is bigger than one workbook (a whole recurring process you want automated end to end), we start with a fixed-price automation assessment that scopes the build, projects ROI, and is credited toward the resulting statement of work. There is one assessment for every build."
  },
  {
    q: "How do you price a fixed quote so fast?",
    a: "The free 30-minute discovery call captures the artifact, the outcome, the data sources, and the cadence. That maps cleanly to the right option, so you get a flat price within one business day. Fixed scope means fixed price. New asks become a new package or a change order, never silent scope creep."
  },
  {
    q: "Isn't this just something AI can do now?",
    a: "AI is great at producing a spreadsheet that looks right. It cannot tell you the reconciliation doesn't tie, the accrual is backwards, or the number will mislead the CFO. A CPA-trained finance veteran with 30 years in the field can. We use the same AI everyone else has to deliver faster, and we are the accountability layer that catches when the AI is wrong. In finance, the expensive failure is not slow. It is looks right but is quietly wrong."
  },
  {
    q: "Is this just Excel work, or the whole Microsoft stack?",
    a: "Excel and Power Query are the entry point because that's where the daily pain usually lives, but the work spans the whole Microsoft Power Platform and Copilot. We build governed Power BI dashboards with automated refresh, approval and data flows in Power Automate, lightweight internal apps in Power Apps, and custom low-code agents over your own data with Copilot Studio, plus Microsoft 365 Copilot rollout where it earns its seat. The through-line is finance and operations: we turn manual, error-prone Microsoft-stack work into automated, governed, audit-ready processes, not generic IT projects."
  },
  {
    q: "What's included, and what isn't?",
    a: "Fixed price covers the defined scope, plus a QA tie-out against a known-good baseline and a short Loom walkthrough at handoff. Not included: ongoing maintenance after handoff (that's a separate retainer), net-new data sources discovered mid-build, or work requiring production system credentials we weren't scoped for. We state this plainly up front so there are no surprises."
  },
  {
    q: "How do I pay?",
    a: "Everything is quoted as a fixed price up front from the free discovery call, so you approve the number before any work begins. Larger builds start with a fixed-price assessment that's credited toward the statement of work if you proceed. No metered hours, no surprise invoices."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Forge Quick Wins",
  "provider": {
    "@type": "Organization",
    "name": "Forge RPA LLC",
    "url": "https://forgerpa.com"
  },
  "serviceType": "Microsoft Power Platform and Copilot Automation for Finance and Operations",
  "areaServed": {
    "@type": "Country",
    "name": "United States"
  },
  "description": "Fixed-price Microsoft Power Platform and Copilot automation for finance and operations back office: Excel and Power Query, Power BI, Power Automate, Power Apps, and Copilot Studio agents. Starts with a spreadsheet rescue and scales to governed, audit-ready processes. Built by a CPA-trained finance veteran with 30 years in the field, delivered AI-fast, with a QA tie-out on every job.",
  "url": "https://forgerpa.com/services/quick-wins"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": a
    }
  }))
};
---

<PageLayout
  title="Power Platform & Copilot Automation for Finance | Forge Quick Wins"
  description="Microsoft Power Platform and Copilot automation for finance and operations. Excel and Power Query, Power BI, Power Automate, Power Apps, and Copilot Studio agents. Fixed-price, starting with a spreadsheet rescue, delivered AI-fast with a QA tie-out on every job."
  heroTitle="Automate your Microsoft stack"
  heroSubtitle="Excel, Power Query, Power BI, Power Automate, Power Apps, and Copilot, built for finance and operations and delivered AI-fast by people who have actually closed the books."
  heroCta="See How We Can Help"
  heroCtaLink="/book?from=quick-wins"
>
  <section class="py-20 lg:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Capability strip: the Microsoft stack at a glance -->
      <div class="mb-14">
        <p class="text-sm font-bold text-amber-dark uppercase tracking-wide mb-3">What We Automate</p>
        <div class="flex flex-wrap gap-2.5">
          <span class="rounded-full border border-amber/40 bg-amber/5 px-4 py-1.5 text-sm font-semibold text-charcoal">Excel</span>
          <span class="rounded-full border border-amber/40 bg-amber/5 px-4 py-1.5 text-sm font-semibold text-charcoal">Power Query</span>
          <span class="rounded-full border border-amber/40 bg-amber/5 px-4 py-1.5 text-sm font-semibold text-charcoal">Power BI</span>
          <span class="rounded-full border border-amber/40 bg-amber/5 px-4 py-1.5 text-sm font-semibold text-charcoal">Power Automate</span>
          <span class="rounded-full border border-amber/40 bg-amber/5 px-4 py-1.5 text-sm font-semibold text-charcoal">Power Apps</span>
          <span class="rounded-full border border-amber/40 bg-amber/5 px-4 py-1.5 text-sm font-semibold text-charcoal">Copilot Studio</span>
        </div>
      </div>

      <!-- The Pain -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">The grind that quietly eats your week</h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-10">
          You don't need a six-month RPA project. You need one specific thing to stop being painful. We see the same triggers in nearly every finance and operations team.
        </p>
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-amber/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-amber-dark font-bold">1</span>
            </div>
            <div>
              <h3 class="font-bold text-charcoal">A monthly report rebuilt by hand, every single cycle</h3>
              <p class="text-gray-600 mt-1">The same exports, the same copy-paste, the same lookups. Hours that should be analysis instead go to reassembly.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-amber/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-amber-dark font-bold">2</span>
            </div>
            <div>
              <h3 class="font-bold text-charcoal">A workbook that broke, or got too slow to trust</h3>
              <p class="text-gray-600 mt-1">Formulas that error, links that snapped, a file that takes five minutes to open. You're not sure the number is even right anymore.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-amber/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-amber-dark font-bold">3</span>
            </div>
            <div>
              <h3 class="font-bold text-charcoal">The person who owned the spreadsheet just left</h3>
              <p class="text-gray-600 mt-1">Now nobody understands how it works, and the close depends on it. You need it documented, dependable, and not in one person's head.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-amber/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-amber-dark font-bold">4</span>
            </div>
            <div>
              <h3 class="font-bold text-charcoal">Data living in three systems that don't talk</h3>
              <p class="text-gray-600 mt-1">Every report means manual exports from each one, then stitching them together by hand and hoping they tie.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-amber/10 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-amber-dark font-bold">5</span>
            </div>
            <div>
              <h3 class="font-bold text-charcoal">Pre-close crunch that swallows your evenings</h3>
              <p class="text-gray-600 mt-1">A few manual steps stand between you and a clean close, and they cost you the same nights every month.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- What We Build Across the Microsoft Stack -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">What We Build Across the Microsoft Stack</h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-10">
          A broken spreadsheet is usually the front door, not the whole house. We are a Microsoft Power Platform and Copilot automation partner for the finance and operations back office. The goal is the same at every layer: turn manual, error-prone Microsoft-stack work into automated, governed, audit-ready processes, built around how finance and ops actually run, not generic IT. We match the tool to the job, so you never get more platform than the problem needs.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-slate-light rounded-xl p-6">
            <h3 class="font-bold text-charcoal mb-2">Excel + Power Query</h3>
            <p class="text-gray-600 text-sm">Clean it, automate it, schedule it. We turn copy-paste rebuilds into queries that pull, shape, and refresh on a click or a timer, so the monthly report assembles itself and ties every time.</p>
          </div>
          <div class="bg-slate-light rounded-xl p-6">
            <h3 class="font-bold text-charcoal mb-2">Power BI</h3>
            <p class="text-gray-600 text-sm">Governed dashboards with automated refresh, a documented data model, and one version of the number everyone trusts. Built so the close, AP, or operations view stays current without anyone rebuilding it.</p>
          </div>
          <div class="bg-slate-light rounded-xl p-6">
            <h3 class="font-bold text-charcoal mb-2">Power Automate</h3>
            <p class="text-gray-600 text-sm">Approval and data flows that move work between systems, route exceptions, and capture an audit trail. The manual hand-offs between three screens become a flow that runs and logs itself.</p>
          </div>
          <div class="bg-slate-light rounded-xl p-6">
            <h3 class="font-bold text-charcoal mb-2">Power Apps</h3>
            <p class="text-gray-600 text-sm">Lightweight internal apps for the intake forms, trackers, and approvals that don't deserve a spreadsheet shared by twelve people. Custom-built to your process, owned by your team.</p>
          </div>
          <div class="bg-slate-light rounded-xl p-6 md:col-span-2">
            <h3 class="font-bold text-charcoal mb-2">Copilot + Copilot Studio</h3>
            <p class="text-gray-600 text-sm">Microsoft 365 Copilot rolled out where it earns its seat, and custom low-code agents built in Copilot Studio that answer questions and take action over your own finance and operations data. Grounded in your numbers, with the same accountability layer that catches when the AI is confidently wrong.</p>
          </div>
        </div>
      </div>

      <!-- Positioning -->
      <div class="mb-16 bg-gradient-to-br from-charcoal to-charcoal-light rounded-xl p-8 lg:p-12">
        <h2 class="text-2xl lg:text-3xl font-bold text-amber mb-6">We don't sell tool licenses. We sell judgment that AI can't replace.</h2>
        <p class="text-lg text-gray-200 leading-relaxed">
          In finance, the expensive failure mode is not slow. It is looks right but is quietly wrong. Generative AI is excellent at producing a spreadsheet, a dashboard, or a Copilot answer that looks right. It cannot tell you the reconciliation doesn't tie, the accrual is backwards, or the number will mislead the CFO.
        </p>
        <p class="mt-4 text-lg text-gray-200 leading-relaxed">
          A CPA-trained finance veteran with 30 years in the field can. That judgment and accountability layer is exactly what survives the AI wave. We use the same AI everyone else has as a delivery accelerator, so you get senior work at a fair fixed price, faster than a traditional consultant, and you get the person who knows when the AI is wrong.
        </p>
      </div>

      <InlineCta
        text="Have a workbook quietly eating your week?"
        ctaText="See How We Can Help"
        ctaLink="/book?from=quick-wins"
      />

      {/*
        INTRO-PAGE SIMPLICITY (David, 2026-06-16). Removed the "What It Costs",
        "What You Get", and "How It Works" sections. On a first-touch intro page
        that detail is too exhaustive; a prospect gets it on the discovery call
        or in the assessment. Keep intro/service pages lean: what we do -> proof
        -> talk to us. This treatment likely applies to the other service and
        industry pages too (apply when revisiting them).
      */}

      <!-- Proof / Trust signals -->
      <div class="mb-16 bg-amber/5 border-l-4 border-amber rounded-r-xl p-8 lg:p-10">
        <h2 class="text-2xl lg:text-3xl font-bold text-charcoal mb-4">The kind of grind we make disappear</h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-8">
          Quick Wins are sized down from the same finance and automation work behind these results.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl border border-amber/30 p-6">
            <p class="text-2xl font-extrabold text-charcoal mb-1">Days to one day</p>
            <p class="text-gray-600 text-sm">Cut a restaurant company's financial-statement package from a multi-day grind down to a single day.</p>
          </div>
          <div class="bg-white rounded-xl border border-amber/30 p-6">
            <p class="text-2xl font-extrabold text-charcoal mb-1">Nearly $1M saved</p>
            <p class="text-gray-600 text-sm">A custom time-management system for an insurance company that saved close to a million dollars.</p>
          </div>
          <div class="bg-white rounded-xl border border-amber/30 p-6">
            <p class="text-2xl font-extrabold text-charcoal mb-1">40 templates, under 1 hour</p>
            <p class="text-gray-600 text-sm">An automated Workday conversion handling roughly 40 iLoad templates in under an hour.</p>
          </div>
          <div class="bg-white rounded-xl border border-amber/30 p-6">
            <p class="text-2xl font-extrabold text-charcoal mb-1">100+ automations</p>
            <p class="text-gray-600 text-sm">Over 100 intelligent automations deployed at a Fortune 500 manufacturer. CPA background, 30 years in finance.</p>
          </div>
        </div>
      </div>

      <!-- Where this leads -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">When a quick win uncovers a bigger one</h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-8">
          Most quick wins surface a larger recurring pain underneath. When that happens, we name it and you decide. There's a clear next step when the conversation turns to "this whole process should run itself."
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <a href="/services/automation-assessment" class="block bg-white border border-gray-200 rounded-xl p-6 hover:border-amber transition-colors">
            <h3 class="font-bold text-charcoal mb-2">What the Assessment Covers</h3>
            <p class="text-gray-600 text-sm mb-4">A focused diagnostic that scores the whole process for automation potential, projects ROI, and hands you a prioritized roadmap. Credited toward your build.</p>
            <span class="text-amber-dark font-semibold text-sm">Learn More →</span>
          </a>
          <a href="/services/sop-automation" class="block bg-white border border-gray-200 rounded-xl p-6 hover:border-amber transition-colors">
            <h3 class="font-bold text-charcoal mb-2">Finance &amp; Operations Process Automation</h3>
            <p class="text-gray-600 text-sm mb-4">Full builds for the recurring processes worth automating end to end, with reliability and ownership baked in.</p>
            <span class="text-amber-dark font-semibold text-sm">Learn More →</span>
          </a>
        </div>
      </div>

      <!-- FAQ -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-charcoal mb-6">Common Questions</h2>
        <div class="space-y-4">
          {faqs.map(({ q, a }) => (
            <details class="bg-slate-light rounded-xl p-6 group">
              <summary class="font-bold text-charcoal cursor-pointer flex items-center justify-between">
                <span>{q}</span>
                <span class="text-amber-dark text-2xl group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="text-gray-700 mt-4 leading-relaxed">{a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </section>

  <CTASection
    heading="Tell us the manual work that's costing you"
    subtext="Book a free 30-minute discovery call. We'll tell you straight which option fits and quote a flat price within one business day. No pitch."
    ctaText="See How We Can Help"
    ctaLink="/book?from=quick-wins"
  />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</PageLayout>
