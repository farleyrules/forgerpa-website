<style>
  /*
   * Scoped typography for the Terms & Conditions, mirroring the scoped
   * `.privacy-content` block on the Privacy Policy page. The site doesn't use
   * @tailwindcss/typography, so styles here are scoped to `.legal-content` and
   * target descendant elements directly.
   */

  .legal-content {
    color: #1f2937; /* gray-800 */
    font-size: 1.0625rem; /* ~17px */
    line-height: 1.7;
  }

  /* Section dividers */
  .legal-content hr {
    border: 0;
    border-top: 1px solid #e5e7eb; /* gray-200 */
    margin: 3rem 0;
  }

  /* H2: major section headings */
  .legal-content h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #111827; /* gray-900 */
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .legal-content hr + h2 {
    margin-top: 0.5rem;
  }

  /* H3: subsection headings */
  .legal-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #111827;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  /* Paragraphs */
  .legal-content p {
    margin-top: 0;
    margin-bottom: 1.25rem;
  }

  /* Lists */
  .legal-content ul,
  .legal-content ol {
    margin-top: 0.75rem;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .legal-content ul {
    list-style: disc;
  }
  .legal-content ol {
    list-style: decimal;
  }
  .legal-content li {
    margin-bottom: 0.5rem;
  }
  .legal-content li > strong {
    color: #111827;
  }

  /* Links */
  .legal-content a {
    color: #b45309; /* amber-700, readable on white */
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .legal-content a:hover {
    color: #92400e; /* amber-800 */
  }

  /* Inline code */
  .legal-content code {
    background-color: #f3f4f6; /* gray-100 */
    color: #111827;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  }

  /* Strong */
  .legal-content strong {
    color: #111827;
    font-weight: 600;
  }

  /* Scope notice callout: the "website only" notice, styled as a normal
     informational callout (NOT an internal draft banner). */
  .legal-content .scope-notice {
    background-color: #fffbeb; /* amber-50 */
    border: 1px solid #fcd34d; /* amber-300 */
    border-left-width: 4px;
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0 2rem;
  }
  .legal-content .scope-notice p {
    margin-bottom: 0.5rem;
  }
  .legal-content .scope-notice p:last-child {
    margin-bottom: 0;
  }

  /* The intro effective-date / version stamp gets a bottom rule like privacy. */
  .legal-content > p:first-of-type {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e7eb;
  }
</style>
