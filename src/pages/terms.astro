  'The terms that govern your access to and use of the forgerpa.com website.';
const heroSubtitle =
  'The agreement that governs your use of this website. Paid services are covered separately by a Master Services Agreement.';

const effectiveDate = 'June 1, 2026';
const version = 'v1 (2026-06-01)';
