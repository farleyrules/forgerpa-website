# Copy to .env for local builds (optional). For production, set secrets in Cloudflare Pages → Settings → Environment variables.

# Cloudflare API (used by wrangler deploy — see DEPLOY.md)
# CLOUDFLARE_API_TOKEN=

# Google Analytics 4 — get from https://analytics.google.com (Admin → Data Streams)
PUBLIC_GA4_MEASUREMENT_ID=

# Google Search Console — get from Search Console property settings (HTML tag verification method)
PUBLIC_GSC_VERIFICATION_TOKEN=

# Google Ads conversion tracking — get from Google Ads UI (Tools & Settings → Conversions → Tag setup)
PUBLIC_GOOGLE_ADS_CONVERSION_ID=
