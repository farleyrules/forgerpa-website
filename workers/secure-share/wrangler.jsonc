{
  // Forge RPA Secure Share: a standalone Cloudflare Worker, deployed separately
  // from the marketing site (this is NOT built by the forgerpa.com Git
  // connection). Deploy with `npx wrangler deploy` from this directory.
  "name": "forge-secure-share",
  "main": "src/index.js",
  "compatibility_date": "2026-06-22",

  // Only the custom domain serves this Worker. workers.dev is disabled so the
  // Cloudflare Access gate on secure.forgerpa.com/admin cannot be bypassed via a
  // *.workers.dev URL.
  "workers_dev": false,

  "routes": [{ "pattern": "secure.forgerpa.com", "custom_domain": true }],

  // Secrets live in a per-secret Durable Object (idFromName(id)): strong
  // consistency gives an atomic read-and-delete, so burn-after-read has no race.
  "durable_objects": {
    "bindings": [{ "name": "SECRET_DO", "class_name": "SecretDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SecretDO"] }],

  // KV is retained only for best-effort per-IP rate-limit counters (not secrets).
  "kv_namespaces": [
    {
      "binding": "SECRETS",
      "id": "206a37a83e6b4ef69b8e491c9e62493b",
      "preview_id": "206a37a83e6b4ef69b8e491c9e62493b"
    }
  ],

  "vars": {
    "DEFAULT_TTL_SECONDS": "259200",
    "MIN_TTL_SECONDS": "300",
    "MAX_TTL_SECONDS": "604800",
    "MAX_CIPHERTEXT_BYTES": "122880",
    "CREATE_LIMIT": "20",
    "CREATE_WINDOW": "600",
    "REVEAL_LIMIT": "60",
    "REVEAL_WINDOW": "60",
    "COCKPIT_URL": "https://sales.forgerpa.com"
    // Email delivery + open-receipts go through the forgerpa-sales cockpit. The
    // shared secret is NOT here (it is a secret). Set it with:
    //   npx wrangler secret put SECURE_SHARE_SECRET
    // and set the SAME value in the Vercel env for forgerpa-sales. Until set,
    // the email + receipt features are inert (the create UI says "not set up").
    // Access defense-in-depth (set AFTER the Access app exists, then redeploy):
    //   "ACCESS_TEAM_DOMAIN": "forgerpa.cloudflareaccess.com",
    //   "ACCESS_AUD": "<application audience tag from the Access app>"
    // While unset, the Worker skips JWT verification (Cloudflare Access at the
    // edge is the gate). Once set, POST /admin/api/create also verifies the
    // Cf-Access-Jwt-Assertion signature, audience, and expiry.
  }
}
